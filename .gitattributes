# Keep source and documentation diffs stable across Windows and Unix checkouts.
* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf

*.c text eol=lf
*.def text eol=lf
*.h text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ml text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.sha256 text eol=lf
*.txt text eol=lf
*.vert text eol=lf
*.frag text eol=lf

# Generated and media files must never undergo line-ending conversion.
*.dll binary
*.exe binary
*.png binary
*.spv binary
*.tga binary
