diff --git a/WinQuake/mq_renderer_trace_fixture.c b/WinQuake/mq_renderer_trace_fixture.c
new file mode 100644
index 0000000..ed9c166
--- /dev/null
+++ b/WinQuake/mq_renderer_trace_fixture.c
@@ -0,0 +1,76 @@
+/*
+Deterministic diagnostic GL sink for MiniQuake renderer parity.
+This file exists only in the generated, patched reference worktree.
+*/
+
+#include <stdio.h>
+#include "mq_renderer_trace_fixture.h"
+
+mq_cvar_t gl_nobind = {0.0f};
+int char_texture = 0;
+int currenttexture = -1;
+qpic_t *draw_backtile = 0;
+
+static unsigned int mq_trace_sequence;
+
+static void MQ_TracePrefix (const char *operation)
+{
+	printf ("{\"schema\":\"miniquake.renderer.gl.v1\","
+		"\"scene\":\"draw_tile_clear\",\"seq\":%u,"
+		"\"op\":\"%s\",\"args\":", mq_trace_sequence++, operation);
+}
+
+void MQ_TraceReset (void)
+{
+	mq_trace_sequence = 0;
+}
+
+static void MQ_API MQ_TraceBindTexture (unsigned int target, unsigned int texture)
+{
+	MQ_TracePrefix ("bind_texture");
+	printf ("[%u,%u]}\n", target, texture);
+}
+
+mq_bind_texture_t bindTexFunc = MQ_TraceBindTexture;
+
+void MQ_API glColor3f (float red, float green, float blue)
+{
+	MQ_TracePrefix ("color");
+	printf ("[%.9g,%.9g,%.9g,1]}\n", red, green, blue);
+}
+
+void MQ_API glBegin (unsigned int mode)
+{
+	MQ_TracePrefix ("begin");
+	printf ("[%u]}\n", mode);
+}
+
+void MQ_API glTexCoord2f (float s, float t)
+{
+	MQ_TracePrefix ("texcoord");
+	printf ("[%.9g,%.9g]}\n", s, t);
+}
+
+void MQ_API glVertex2f (float x, float y)
+{
+	MQ_TracePrefix ("vertex");
+	printf ("[%.9g,%.9g]}\n", x, y);
+}
+
+void MQ_API glEnd (void)
+{
+	MQ_TracePrefix ("end");
+	printf ("[]}\n");
+}
+
+int main (void)
+{
+	qpic_t tile = {64, 64, {0, 0, 0, 0}};
+
+	*(int *)tile.data = 77;
+	draw_backtile = &tile;
+	currenttexture = -1;
+	MQ_TraceReset ();
+	Draw_TileClear (16, 24, 96, 40);
+	return 0;
+}
