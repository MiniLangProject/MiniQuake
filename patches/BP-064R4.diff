+function SignbitsForPlane(plane)
+  bitsValue = 0
+  if plane.normal.x < 0.0 then bitsValue = bitsValue | 1 end if
+  if plane.normal.y < 0.0 then bitsValue = bitsValue | 2 end if
+  if plane.normal.z < 0.0 then bitsValue = bitsValue | 4 end if
