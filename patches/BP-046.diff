+end function
+
+function testMeshTerminationAndCacheBranches()
+  model = aliasSource("progs/cache-branch.mdl")
+  model.texCoords = [
+    t.MdlTexCoord(0, 0, 0), t.MdlTexCoord(0, 3, 0),
