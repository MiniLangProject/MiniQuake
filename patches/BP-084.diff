-    ml_files = sorted((root / "src").rglob("*.ml")) + sorted((root / "tests").glob("*.ml"))
-    ps_files = sorted(root.glob("*.ps1")) + sorted((root / "scripts").glob("*.ps1"))
-    for path in ml_files:
-        ok, why = _balanced_delimiters(path.read_text(encoding="utf-8-sig"))
-        if not ok: errors.append(f"{path.relative_to(root)}: {why}")
-    for path in ps_files:
-        # PowerShell has here-strings, comments and quoting rules that the small
-        # MiniLang delimiter scanner intentionally does not model.  Restrict the
-        # portable preflight to the concrete delivery regression we need to
-        # prevent: a comma immediately before a closing call parenthesis.
-        text = path.read_text(encoding="utf-8-sig")
-        if re.search(r",\s*\)", text):
-            errors.append(f"{path.relative_to(root)} contains a trailing comma before )")
-    details.update({"minilang_files": len(ml_files), "powershell_files": len(ps_files)})
-    return CheckResult("source_structure", not errors, details, errors)
