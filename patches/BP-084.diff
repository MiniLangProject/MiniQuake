-def parse_pe_export_names(
-    data: bytes,
-    *,
-    pe_offset: int,
-    optional_size: int,
-    section_count: int,
-) -> list[str]:
-    optional_offset = pe_offset + 24
-    # PE32+ stores NumberOfRvaAndSizes at +108 and the export directory at +112.
-    if optional_size < 120 or optional_offset + 120 > len(data):
-        raise ValueError("PE32+ optional header has no export data directory")
-    directory_count = struct.unpack_from("<I", data, optional_offset + 108)[0]
-    if directory_count < 1:
-        return []
-    export_rva, export_size = struct.unpack_from("<II", data, optional_offset + 112)
-    if export_rva == 0 or export_size == 0:
-        return []
-
-    export_offset = pe_rva_to_file_offset(
-        data,
-        pe_offset=pe_offset,
-        optional_size=optional_size,
-        section_count=section_count,
-        rva=export_rva,
-    )
-    if export_offset + 40 > len(data):
-        raise ValueError("truncated IMAGE_EXPORT_DIRECTORY")
-    (
-        _characteristics,
-        _timestamp,
-        _major,
-        _minor,
-        _dll_name_rva,
-        _ordinal_base,
-        _function_count,
-        name_count,
-        _function_table_rva,
-        name_table_rva,
-        _ordinal_table_rva,
-    ) = struct.unpack_from("<IIHHIIIIIII", data, export_offset)
-    if name_count > 100000:
-        raise ValueError(f"implausible PE export-name count: {name_count}")
-    if name_count == 0:
-        return []
-
-    name_table_offset = pe_rva_to_file_offset(
-        data,
-        pe_offset=pe_offset,
-        optional_size=optional_size,
-        section_count=section_count,
-        rva=name_table_rva,
-    )
-    if name_table_offset + name_count * 4 > len(data):
-        raise ValueError("truncated PE export-name pointer table")
-
-    names: list[str] = []
-    for index in range(name_count):
-        name_rva = struct.unpack_from("<I", data, name_table_offset + index * 4)[0]
-        name_offset = pe_rva_to_file_offset(
-            data,
-            pe_offset=pe_offset,
-            optional_size=optional_size,
-            section_count=section_count,
-            rva=name_rva,
-        )
-        names.append(read_pe_c_string(data, name_offset))
-    return names
