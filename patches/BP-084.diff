-def _balanced_delimiters(text: str) -> tuple[bool, str]:
-    stack: list[str] = []
-    pairs = {")": "(", "]": "[", "}": "{"}
-    opening = set(pairs.values())
-    quote = None
-    escaped = False
-    line_comment = False
-    block_comment = False
-    i = 0
-    while i < len(text):
-        ch = text[i]
-        nxt = text[i + 1] if i + 1 < len(text) else ""
-        if line_comment:
-            if ch == "\n": line_comment = False
-            i += 1; continue
-        if block_comment:
-            if ch == "*" and nxt == "/": block_comment = False; i += 2; continue
-            i += 1; continue
-        if quote:
-            if escaped: escaped = False
-            elif ch == "\\": escaped = True
-            elif ch == quote: quote = None
-            i += 1; continue
-        if ch == "/" and nxt == "/": line_comment = True; i += 2; continue
-        if ch == "/" and nxt == "*": block_comment = True; i += 2; continue
-        if ch in ('"', "'"): quote = ch; i += 1; continue
-        if ch in opening: stack.append(ch)
-        elif ch in pairs:
-            if not stack or stack.pop() != pairs[ch]: return False, f"unexpected {ch}"
-        i += 1
-    if quote or block_comment or stack: return False, "unterminated string/comment/delimiter"
-    return True, ""
