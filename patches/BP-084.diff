-def _call_argument_counts(text: str, marker: str) -> list[int]:
-    counts: list[int] = []
-    search_at = 0
-    while True:
-        start = text.find(marker, search_at)
-        if start < 0:
-            break
-        position = start + len(marker)
-        depth = 1
-        argument_count = 0
-        argument_has_token = False
-        in_string = False
-        escaped = False
-        line_comment = False
-        block_comment = False
-        while position < len(text) and depth > 0:
-            character = text[position]
-            next_character = text[position + 1] if position + 1 < len(text) else ""
-            if line_comment:
-                if character == "\n":
-                    line_comment = False
-                position += 1
-                continue
-            if block_comment:
-                if character == "*" and next_character == "/":
-                    block_comment = False
-                    position += 2
-                else:
-                    position += 1
-                continue
-            if in_string:
-                if escaped:
-                    escaped = False
-                elif character == "\\":
-                    escaped = True
-                elif character == '"':
-                    in_string = False
-                position += 1
-                continue
-            if character == "/" and next_character == "/":
-                line_comment = True
-                position += 2
-                continue
-            if character == "/" and next_character == "*":
-                block_comment = True
-                position += 2
-                continue
-            if character == '"':
-                in_string = True
-                argument_has_token = True
-            elif character in "([":
-                depth += 1
-                argument_has_token = True
-            elif character in ")]":
-                depth -= 1
-                if depth == 0:
-                    if argument_has_token:
-                        argument_count += 1
-                    break
-                argument_has_token = True
-            elif character == "," and depth == 1:
-                if argument_has_token:
-                    argument_count += 1
-                argument_has_token = False
-            elif not character.isspace():
-                argument_has_token = True
-            position += 1
-        if depth != 0:
-            counts.append(-1)
-            break
-        counts.append(argument_count)
-        search_at = position + 1
-    return counts
-
