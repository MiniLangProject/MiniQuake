+package miniquake.tests.black_port_source_closure
+
+import miniquake.black_port_source_contract as closure
+import miniquake.source_profile_contract as profile
+import miniquake.black_port_corpus as corpus
+
+failures = 0
+checks = 0
+
+function check(condition, label)
+  global failures, checks
+  checks = checks + 1
+  if not condition then failures = failures + 1; print "FAIL: " + label end if
+end function
+
+function equal(actual, expected, label)
+  check(actual == expected, label + ": expected " + expected + ", got " + actual)
+end function
+
+function main(args)
+  global failures, checks
+  vector = closure.contractVector()
+
+  print "[1/24] status"
+  equal(closure.STATUS, "black_port_source_109_frozen_v1", "status")
+
+  print "[2/24] fingerprint"
+  equal(closure.FINGERPRINT, 0x309b0737, "fingerprint")
+
+  print "[3/24] schema"
+  equal(closure.SCHEMA_VERSION, 1, "schema")
+
+  print "[4/24] source units"
+  equal(closure.SOURCE_UNIT_COUNT, 53, "source units")
+
+  print "[5/24] header units"
+  equal(closure.HEADER_UNIT_COUNT, 10, "header units")
+
+  print "[6/24] target functions"
+  equal(closure.TARGET_FUNCTION_COUNT, 1094, "target functions")
+
+  print "[7/24] exact names"
+  equal(profile.EXACT_NAME, 1081, "exact names")
+
+  print "[8/24] adapters"
+  equal(profile.CONTEXT_ADAPTER, 9, "adapters")
+
+  print "[9/24] equivalents"
+  equal(profile.TECHNICAL_EQUIVALENT, 4, "equivalents")
+
+  print "[10/24] unclassified"
+  equal(closure.UNCLASSIFIED_FUNCTION_COUNT, 0, "unclassified")
+
+  print "[11/24] profile excluded"
+  equal(profile.PROFILE_EXCLUDED, 26, "profile excluded")
+
+  print "[12/24] definitions discovered"
+  equal(profile.DEFINITIONS_DISCOVERED, 1120, "discovered")
+
+  print "[13/24] corpus scenarios"
+  equal(closure.CORPUS_SCENARIO_COUNT, 4, "corpus scenarios")
+
+  print "[14/24] corpus frames"
+  equal(closure.CORPUS_FRAMES_PER_SCENARIO, 64, "corpus frames")
+
+  print "[15/24] vector length"
+  equal(len(vector), 10, "vector length")
+
+  print "[16/24] vector schema"
+  equal(vector[0], 1, "vector schema")
+
+  print "[17/24] vector target"
+  equal(vector[3], 1094, "vector target")
+
+  print "[18/24] vector exact"
+  equal(vector[4], 1081, "vector exact")
+
+  print "[19/24] vector adapter"
+  equal(vector[5], 9, "vector adapters")
+
+  print "[20/24] vector equivalent"
+  equal(vector[6], 4, "vector equivalents")
+
+  print "[21/24] vector missing"
+  equal(vector[7], 0, "vector missing")
+
+  print "[22/24] source profile validation"
+  check(profile.validate(), "profile validation")
+
+  print "[23/24] corpus validation"
+  check(corpus.validate(), "corpus validation")
+
+  print "[24/24] closure validation"
+  check(closure.validate(), "closure validation")
+
+  if failures > 0 then
+    print "MiniQuake BP-084 source black-port closure tests failed: " + failures + "/" + checks
+    return 1
+  end if
+  print "MiniQuake BP-084 source black-port closure tests passed: 24"
+  return 0
+end function
