+﻿[CmdletBinding()]
+param(
+  [string]$Compiler = "",
+  [Alias("StdLibPath", "ImportRoot")]
+  [string]$StdLib = "",
+  [string]$Python = "",
+  [string]$QuakeBase = "",
+  [string]$Game = "id1",
+  [string]$Map = "start",
+  [ValidateRange(1, 1000000)]
