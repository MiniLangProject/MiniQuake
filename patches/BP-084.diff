-def read_pe_c_string(data: bytes, offset: int, maximum: int = 4096) -> str:
-    if offset < 0 or offset >= len(data):
-        raise ValueError("PE string offset is outside the file")
-    end = data.find(b"\0", offset, min(len(data), offset + maximum))
-    if end < 0:
-        raise ValueError("unterminated PE string")
-    try:
-        return data[offset:end].decode("ascii")
-    except UnicodeDecodeError as exc:
-        raise ValueError("non-ASCII PE export name") from exc
-
