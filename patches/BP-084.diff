-def pe_rva_to_file_offset(
-    data: bytes,
-    *,
-    pe_offset: int,
-    optional_size: int,
-    section_count: int,
-    rva: int,
-) -> int:
-    optional_offset = pe_offset + 24
-    if optional_offset + 64 > len(data):
-        raise ValueError("truncated optional header")
-    size_of_headers = struct.unpack_from("<I", data, optional_offset + 60)[0]
-    if rva < size_of_headers:
-        if rva >= len(data):
-            raise ValueError(f"RVA 0x{rva:X} points beyond file headers")
-        return rva
-
-    section_table = optional_offset + optional_size
-    for index in range(section_count):
-        entry = section_table + index * 40
-        if entry + 40 > len(data):
-            raise ValueError("truncated PE section table")
-        virtual_size, virtual_address, raw_size, raw_pointer = struct.unpack_from(
-            "<IIII", data, entry + 8
-        )
-        span = max(virtual_size, raw_size)
-        if virtual_address <= rva < virtual_address + span:
-            relative = rva - virtual_address
-            if relative >= raw_size:
-                raise ValueError(f"RVA 0x{rva:X} has no file-backed bytes")
-            offset = raw_pointer + relative
-            if offset >= len(data):
-                raise ValueError(f"RVA 0x{rva:X} maps beyond end of file")
-            return offset
-    raise ValueError(f"RVA 0x{rva:X} is not covered by a PE section")
-
