+  [string]$Configuration = "Release",
+  [switch]$SkipBuild,
+  [switch]$SkipGameValidation,
+  [switch]$SkipTraceValidation,
+  [switch]$SkipRenderEvidence,
+  [switch]$SkipAudioEvidence,
