+function Add-StepResult {
+  param(
+    [string]$Name,
+    [string]$Status,
+    [int]$ExitCode,
+    [string]$Detail
+  )
+
+  [void]$Steps.Add([ordered]@{
+    name = $Name
+    status = $Status
+    exit_code = $ExitCode
+    detail = $Detail
+  })
+}
