+    value == c.TE_GUNSHOT or
+    value == c.TE_EXPLOSION or
+    value == c.TE_TAREXPLOSION or
+    value == c.TE_WIZSPIKE or
+    value == c.TE_KNIGHTSPIKE or
+    value == c.TE_LAVASPLASH or
+    value == c.TE_TELEPORT
