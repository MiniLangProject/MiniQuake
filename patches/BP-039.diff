+def check_client_render_block_contract(root: Path) -> CheckResult:
+    """Run BP-035..039 checkers and bind the client/render candidate contract."""
+    errors: list[str] = []
+    details: dict[str, object] = {}
+    checkers = [f"check_client_render_{n}.py" for n in ("035", "036", "037", "038", "039")]
+    try:
+        for checker in checkers:
+            completed = subprocess.run(
+                [sys.executable, str(root / "tools" / checker), "--root", str(root)],
+                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
+                timeout=90, check=False,
+            )
+            if completed.returncode != 0:
+                errors.append(f"{checker} failed: {completed.stdout.strip()}")
+        ledger = json.loads((root / "BLOCK_LEDGER.json").read_text(encoding="utf-8"))
+        expected = {
+            "block_id": BLOCK_ID, "parent_package_id": BLOCK_PARENT_PACKAGE_ID,
+            "final_package_id": PACKAGE_ID, "delivery_revision": DELIVERY_REVISION,
+            "delivery_parent": DELIVERY_PARENT, "protocol_status": PROTOCOL_STATUS,
+            "quakec_status": QUAKEC_STATUS, "world_physics_status": WORLD_PHYSICS_STATUS,
+            "host_lifecycle_status": HOST_LIFECYCLE_STATUS,
+            "client_render_status": CLIENT_RENDER_STATUS,
+            "client_render_fingerprint": "0x95e2b295",
+        }
+        for key, wanted in expected.items():
+            if ledger.get(key) != wanted:
+                errors.append(f"BLOCK_LEDGER.json {key} is {ledger.get(key)!r}, expected {wanted!r}")
+        steps = ledger.get("steps") if isinstance(ledger.get("steps"), list) else []
+        ids = [item.get("package_id") for item in steps if isinstance(item, dict)]
+        if ids != ["BP-035", "BP-036", "BP-037", "BP-038", "BP-039"]:
+            errors.append(f"BLOCK_LEDGER.json step order differs: {ids!r}")
+        if ledger.get("block_runtime_fixtures") != 110:
+            errors.append("BLOCK_LEDGER.json fixture total differs from 110")
+        accepted = ledger.get("accepted_parent", {})
+        if accepted.get("status") != "PASS":
+            errors.append("BP-030-034R1 parent is not recorded as PASS")
+        if accepted.get("trace_sha256") != "31647a08ecb3204cd58b71b4fc6f441f5ed814d6c27aa6813ac3e566bf1c4769":
+            errors.append("BP-030-034R1 accepted trace hash differs")
+        for package in ids:
+            patch = root / "patches" / f"{package}.diff"
+            if not patch.is_file() or patch.stat().st_size == 0:
