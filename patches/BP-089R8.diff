+    before[4] <= c.MAX_EDICTS and after[4] <= c.MAX_EDICTS and
+    after[4] <= before[4]
+  entitiesStable = clientEntityHighWaterStable(before[4], after[4], before[5], after[5])
+  clientsStable = after[6] == before[6]
