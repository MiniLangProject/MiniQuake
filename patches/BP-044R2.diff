+def check_minilang_entry_function_shadow_arity(root: Path) -> CheckResult:
+    """Reject entry-local functions that change an imported internal call's arity.
+
+    MiniLang merges an entry point and its complete import closure. A package-free
+    function declared by the entry can therefore be selected for an unqualified
+    call made inside an imported package. The R1 BP-041 entry exposed this when
+    its zero-argument ``standard`` helper shadowed the two-argument filesystem
+    helper used by ``filesystem.initialize``.
+    """
+    errors: list[str] = []
+    warnings: list[str] = []
+    details: dict[str, object] = {}
+    src_root = root / "src"
+    source_files = sorted(src_root.rglob("*.ml"))
+    test_files = sorted((root / "tests").glob("*.ml")) if (root / "tests").is_dir() else []
+    package_pattern = re.compile(
+        r"(?m)^\s*package\s+([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)\s*$"
+    )
+    import_pattern = re.compile(
+        r"(?m)^\s*import\s+([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)"
+        r"(?:\s+as\s+([A-Za-z_][A-Za-z0-9_]*))?\s*$"
+    )
+    function_pattern = re.compile(
+        r"(?m)^\s*(?:static\s+)?function(?:\s+inline)?\s+"
+        r"([A-Za-z_][A-Za-z0-9_]*)\s*\(([^)]*)\)"
+    )
+    main_pattern = re.compile(r"(?m)^\s*function\s+main\s*\(")
+
+    packages: dict[str, Path] = {}
+    imports_by_file: dict[Path, list[tuple[str, str | None]]] = {}
+    functions_by_file: dict[Path, dict[str, int]] = {}
+    internal_calls_by_file: dict[Path, set[str]] = {}
+    clean_by_file: dict[Path, str] = {}
+
+    for path in source_files + test_files:
+        clean = strip_comments(path.read_text(encoding="utf-8"))
+        clean_by_file[path] = clean
+        imports_by_file[path] = import_pattern.findall(clean)
+        package_match = package_pattern.search(clean)
+        if package_match:
+            packages[package_match.group(1)] = path
+        functions: dict[str, int] = {}
+        for match in function_pattern.finditer(clean):
+            arguments = [item for item in match.group(2).split(",") if item.strip()]
+            functions[match.group(1)] = len(arguments)
+        functions_by_file[path] = functions
+
+    for path, functions in functions_by_file.items():
+        clean = clean_by_file[path]
+        calls: set[str] = set()
+        for name in functions:
+            call_pattern = re.compile(r"(?<![A-Za-z0-9_.])" + re.escape(name) + r"\s*\(")
+            definition_pattern = re.compile(
+                r"^\s*(?:static\s+)?function(?:\s+inline)?\s+" + re.escape(name) + r"\s*\("
+            )
+            for line in clean.splitlines():
+                if definition_pattern.search(line):
+                    continue
+                if call_pattern.search(line):
+                    calls.add(name)
+                    break
+        internal_calls_by_file[path] = calls
+
+    entries: list[Path] = []
+    main_file = src_root / "main.ml"
+    if main_file.is_file():
+        entries.append(main_file)
+    # MiniLang also executes package-free top-level test files without an
+    # explicit main(). Every test compilation unit is therefore an entry and
+    # must be checked against its complete import closure.
+    entries.extend(test_files)
+
+    arity_conflicts = 0
+    same_arity_candidates = 0
+    bindings_checked = 0
+    largest_closure = 0
+    for entry in entries:
+        closure: set[Path] = set()
