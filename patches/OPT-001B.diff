+    if (-not (Test-Path -LiteralPath $ContractExe -PathType Leaf)) { throw "-SkipBuild requested but contract test executable is missing" }
+    Add-Step "OPT-001B game and contract build" "SKIPPED" 0 "-SkipBuild"
