+  [int]$WarmupFrames = 300,
+  [int]$BenchmarkFrames = 3000,
+  [int]$HandleWarmupFrames = 1200,
+  [int]$HandleWindowFrames = 5000,
+  [int]$HandleWindows = 3,
+  [int]$E1M2VisibleFrames = 1000,
+  [int]$E1M2HeadlessFrames = 10000,
+  [int]$TransitionFrames = 64,
+  [int]$ListenPort = 0,
