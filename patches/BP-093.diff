+#!/usr/bin/env python3
+from __future__ import annotations
+import argparse,json,pathlib,sys
+
+def main()->int:
+    ap=argparse.ArgumentParser(); ap.add_argument('--root',default='.'); ap.add_argument('--json',default=''); ns=ap.parse_args(); root=pathlib.Path(ns.root).resolve(); errors=[]
+    def read(rel):
+        p=root/rel
+        if not p.is_file(): errors.append('missing file: '+rel); return ''
+        return p.read_text(encoding='utf-8-sig')
+    contract=read('src/miniquake/external_reference_contract.ml'); mainml=read('src/main.ml'); tool=read('tools/compare_original_reference.py'); test=read('tests/original_visual_reference_tests.ml'); harness=read('TEST_BP-090-094.ps1')
+    for m in ['const ORIGINAL_CAPTURE_MIN_SSIM = 0.95','const ORIGINAL_CAPTURE_SEARCH_RADIUS = 2','["demo1", 256]','["demo2", 256]','["demo3", 256]']:
+        if m not in contract: errors.append('missing visual contract marker: '+m)
+    for m in ['--render-demo-evidence','+timedemo']:
+        if m not in mainml: errors.append('missing demo capture marker: '+m)
+    for m in ['"normalization": "none"','temporal_candidate_selection_only','mean_luminance_ssim_8x8','default=0.95','tga_origin_handling']:
+        if m not in tool: errors.append('missing comparator marker: '+m)
+    for m in ["Run-OriginalVisualCapture -Demo $DemoName -Frame 256 -Suffix 'a'", "Run-OriginalVisualCapture -Demo $DemoName -Frame 256 -Suffix 'b'", '$Offset = -2', '$Offset -le 2', "'gl_ztrick 0'", "'gl_clear 1'", "'gl_finish 1'", "'-gamma', '1'", 'original GLQuake captures differ', "'--min-ssim', '0.95'"]:
+        if m not in harness: errors.append('missing visual harness marker: '+m)
+    forbidden=['crop','translation','rescale','gamma-corrected','color-normalized']
+    if 'normalization": "none"' not in tool: errors.append('raw full-frame policy missing')
+    if 'MiniQuake BP-093 original visual reference tests passed: 20' not in test: errors.append('runtime marker missing')
+    report={'schema_version':1,'package':'BP-094','step':'BP-093','status':'PASS' if not errors else 'FAIL','errors':errors,'fixtures':20,'minimum_ssim':0.95,'metric':'mean_luminance_ssim_8x8','normalization':'none','scenarios':3,'original_runs_per_scenario':2}
+    if ns.json: pathlib.Path(ns.json).write_text(json.dumps(report,indent=2,sort_keys=True)+'\n',encoding='utf-8')
+    print('MiniQuake BP-093 original visual reference verification: '+report['status'])
+    for e in errors: print('  [FAIL] '+e)
+    return 0 if not errors else 1
+if __name__=='__main__': sys.exit(main())
diff --git a/tools/compare_original_reference.py b/tools/compare_original_reference.py
new file mode 100755
index 0000000000000000000000000000000000000000..c91ff910fe1cf8c86704c69ca4170e5f4833f5b7
--- /dev/null
+++ b/tools/compare_original_reference.py
@@ -0,0 +1,208 @@
+#!/usr/bin/env python3
+"""Raw full-frame Original GLQuake versus MiniQuake TGA comparator.
+
+The only permitted alignment is temporal candidate selection. TGA origin flags
+are interpreted as part of file decoding, but pixels are never cropped,
+translated, rescaled, gamma-corrected, color-normalized or otherwise altered.
+The release gate uses an 8x8-window luminance SSIM average and also records a
+global SSIM, MAE, MSE, PSNR and exact pixel statistics.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import struct
+from pathlib import Path
+
+WINDOW = 8
+
+
+def read_tga(path: Path) -> tuple[int, int, bytes]:
+    data = path.read_bytes()
+    if len(data) < 18:
+        raise ValueError(f"{path}: truncated TGA")
+    ident = data[0]
+    colormap_type = data[1]
+    image_type = data[2]
+    width = struct.unpack_from("<H", data, 12)[0]
+    height = struct.unpack_from("<H", data, 14)[0]
+    depth = data[16]
+    descriptor = data[17]
+    if colormap_type != 0 or image_type != 2 or depth != 24:
+        raise ValueError(f"{path}: expected uncompressed non-paletted 24-bit TGA")
+    if width <= 0 or height <= 0:
+        raise ValueError(f"{path}: invalid TGA dimensions {width}x{height}")
+    offset = 18 + ident
+    expected = width * height * 3
+    payload = data[offset : offset + expected]
+    if len(payload) != expected:
+        raise ValueError(f"{path}: truncated pixel payload")
+
+    # Decode TGA origin semantics into a common logical top-left / left-to-right
+    # raster. This is file-format interpretation, not comparison normalization.
+    top_origin = bool(descriptor & 0x20)
+    right_origin = bool(descriptor & 0x10)
+    if top_origin and not right_origin:
+        return width, height, payload
+    output = bytearray(expected)
+    for stored_y in range(height):
+        logical_y = stored_y if top_origin else height - 1 - stored_y
+        for stored_x in range(width):
+            logical_x = width - 1 - stored_x if right_origin else stored_x
+            source = (stored_y * width + stored_x) * 3
+            target = (logical_y * width + logical_x) * 3
+            output[target : target + 3] = payload[source : source + 3]
+    return width, height, bytes(output)
+
+
+def luminance_bgr(payload: bytes) -> list[float]:
+    result = [0.0] * (len(payload) // 3)
+    out = 0
+    for index in range(0, len(payload), 3):
+        b, g, r = payload[index], payload[index + 1], payload[index + 2]
+        result[out] = 0.114 * b + 0.587 * g + 0.299 * r
+        out += 1
+    return result
+
+
+def ssim_values(a: list[float], b: list[float]) -> float:
+    count = len(a)
+    if count == 0 or len(b) != count:
+        raise ValueError("invalid SSIM sample window")
+    mean_a = sum(a) / count
+    mean_b = sum(b) / count
+    var_a = sum((x - mean_a) ** 2 for x in a) / count
+    var_b = sum((x - mean_b) ** 2 for x in b) / count
+    cov = sum((x - mean_a) * (y - mean_b) for x, y in zip(a, b)) / count
+    c1 = (0.01 * 255.0) ** 2
+    c2 = (0.03 * 255.0) ** 2
+    denom = (mean_a * mean_a + mean_b * mean_b + c1) * (var_a + var_b + c2)
+    return ((2 * mean_a * mean_b + c1) * (2 * cov + c2)) / denom if denom else 1.0
+
+
+def windowed_ssim(a: list[float], b: list[float], width: int, height: int) -> float:
+    values: list[float] = []
+    for y0 in range(0, height, WINDOW):
+        y1 = min(y0 + WINDOW, height)
+        for x0 in range(0, width, WINDOW):
+            x1 = min(x0 + WINDOW, width)
+            left: list[float] = []
+            right: list[float] = []
+            for y in range(y0, y1):
+                start = y * width + x0
+                end = y * width + x1
+                left.extend(a[start:end])
+                right.extend(b[start:end])
+            values.append(ssim_values(left, right))
+    return sum(values) / len(values)
+
+
+def metrics(a: bytes, b: bytes, width: int, height: int) -> dict[str, float | int]:
+    if len(a) != len(b):
+        raise ValueError("pixel payload lengths differ")
+    n = len(a)
+    absolute = 0
+    squared = 0
+    changed_bytes = 0
+    for x, y in zip(a, b):
+        difference = x - y
+        if difference:
+            changed_bytes += 1
+        absolute += abs(difference)
+        squared += difference * difference
+    mae = absolute / n
+    mse = squared / n
+    psnr = float("inf") if mse == 0 else 10.0 * math.log10((255.0 * 255.0) / mse)
+    la = luminance_bgr(a)
+    lb = luminance_bgr(b)
+    global_ssim = ssim_values(la, lb)
+    local_ssim = windowed_ssim(la, lb, width, height)
+    changed_pixels = sum(
+        1
+        for index in range(0, n, 3)
+        if a[index : index + 3] != b[index : index + 3]
+    )
+    return {
+        "mae": mae,
+        "mse": mse,
+        "psnr": psnr,
+        "ssim": local_ssim,
+        "ssim_windowed_8x8": local_ssim,
+        "ssim_global": global_ssim,
+        "changed_bytes": changed_bytes,
+        "changed_pixels": changed_pixels,
+        "total_pixels": width * height,
+    }
+
+
+def parse_candidate(text: str) -> tuple[int, Path]:
+    frame_text, sep, path_text = text.partition(":")
+    if not sep:
+        raise argparse.ArgumentTypeError("candidate must be FRAME:PATH")
+    try:
+        frame = int(frame_text)
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError("candidate frame must be an integer") from exc
+    return frame, Path(path_text)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("original", type=Path)
+    parser.add_argument("--candidate", action="append", type=parse_candidate, required=True)
+    parser.add_argument("--min-ssim", type=float, default=0.95)
+    parser.add_argument("--json-out", "--json-output", dest="json_out", type=Path, required=True)
+    parser.add_argument("--scenario", default="")
+    args = parser.parse_args()
+
+    try:
+        ow, oh, original = read_tga(args.original)
+        candidates: list[dict[str, object]] = []
+        for frame, path in args.candidate:
+            cw, ch, pixels = read_tga(path)
+            if (cw, ch) != (ow, oh):
+                raise ValueError(f"{path}: dimensions {cw}x{ch} differ from original {ow}x{oh}")
+            candidates.append({"frame": frame, "path": str(path), **metrics(original, pixels, ow, oh)})
+    except (OSError, ValueError) as exc:
+        print(f"ERROR: {exc}")
+        return 2
+
+    best = max(candidates, key=lambda item: float(item["ssim"]))
+    status = "PASS" if float(best["ssim"]) >= args.min_ssim else "FAIL"
+    report = {
+        "schema_version": 2,
+        "status": status,
+        "scenario": args.scenario,
+        "normalization": "none",
+        "alignment": "temporal_candidate_selection_only",
+        "tga_origin_handling": "decoded_per_file_header",
+        "metric": "mean_luminance_ssim_8x8",
+        "dimensions": [ow, oh],
+        "minimum_ssim": args.min_ssim,
+        "best": best,
+        "candidates": candidates,
+    }
+    args.json_out.parent.mkdir(parents=True, exist_ok=True)
+    args.json_out.write_text(json.dumps(report, indent=2, sort_keys=True, allow_nan=True) + "\n", encoding="utf-8")
+
+    print("MiniQuake BP-093 original visual comparison")
+    print(f"  scenario={args.scenario}")
+    print(f"  dimensions={ow}x{oh}")
+    print("  normalization=none")
+    print("  alignment=temporal_candidate_selection_only")
+    print("  metric=mean_luminance_ssim_8x8")
+    print(f"  best_frame={best['frame']}")
+    print(f"  ssim={float(best['ssim']):.12f}")
+    print(f"  global_ssim={float(best['ssim_global']):.12f}")
+    print(f"  mae={float(best['mae']):.12f}")
+    print(f"  psnr={float(best['psnr']):.12f}")
+    print(f"  changed_pixels={int(best['changed_pixels'])}/{int(best['total_pixels'])}")
+    print(f"  minimum_ssim={args.min_ssim:.12f}")
+    print(f"  report={args.json_out}")
+    print(f"  result={status}")
+    return 0 if status == "PASS" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
