+  highMaxs = math.VectorCopy(maxs)
+  lowMins = math.VectorCopy(mins)
+  lowMaxs = math.VectorCopy(maxs)
+  if node.axis == 0 then
+    highMins.x = node.dist
+    lowMaxs.x = node.dist
