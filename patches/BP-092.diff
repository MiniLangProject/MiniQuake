+++ b/tools/check_external_092.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+import argparse,json,pathlib,sys
+
+def main()->int:
+    ap=argparse.ArgumentParser(); ap.add_argument('--root',default='.'); ap.add_argument('--json',default=''); ns=ap.parse_args(); root=pathlib.Path(ns.root).resolve(); errors=[]
+    def read(rel):
+        p=root/rel
+        if not p.is_file(): errors.append('missing file: '+rel); return ''
+        return p.read_text(encoding='utf-8-sig')
+    host=read('src/miniquake/host.ml'); mainml=read('src/main.ml'); test=read('tests/original_client_interop_tests.ml'); harness=read('TEST_BP-090-094.ps1')
+    for m in ['function runOriginalInteropServer(', 'function interopWriteReady(', 'firstRemoteServerClient(', 'remote.spawned', 'remote.signonStage', 'ready=true port=']:
+        if m not in host: errors.append('missing server interop marker: '+m)
+    for m in ['--original-interop-server','-dedicated', '+map', 'runOriginalInteropServer']:
+        if m not in mainml: errors.append('missing CLI marker: '+m)
+    for m in ["Run-MiniServerOriginalClientPair -Suffix 'a'", "Run-MiniServerOriginalClientPair -Suffix 'b'", 'MiniQuake-server/original-client normalized reports differ', 'Connection accepted', 'Serverinfo packet received', 'CL_SignonReply:\\s*4']:
+        if m not in harness: errors.append('missing process-pair marker: '+m)
+    if 'MiniQuake BP-092 original client interop tests passed: 20' not in test: errors.append('runtime marker missing')
+    report={'schema_version':1,'package':'BP-094','step':'BP-092','status':'PASS' if not errors else 'FAIL','errors':errors,'fixtures':20,'pairs':2,'direction':'miniquake_server_to_original_client'}
+    if ns.json: pathlib.Path(ns.json).write_text(json.dumps(report,indent=2,sort_keys=True)+'\n',encoding='utf-8')
+    print('MiniQuake BP-092 original client interop verification: '+report['status'])
+    for e in errors: print('  [FAIL] '+e)
+    return 0 if not errors else 1
+if __name__=='__main__': sys.exit(main())
