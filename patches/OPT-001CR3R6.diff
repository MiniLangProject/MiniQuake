+    "--prefix", "opt001cr3r6",
+    "--json", (Join-Path $Build "opt001cr3r6-incremental-performance.json"),
+    "--markdown", (Join-Path $Build "opt001cr3r6-incremental-performance.md")
+  ) "opt001cr3r6-incremental-performance.log" -AllowFailure)
