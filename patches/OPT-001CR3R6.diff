+    next = []
+    for each existing in sorted
+      if not inserted and VID_ModeLess(candidate, existing) then
+        next = next + [candidate]
+        inserted = true
+      end if
+      next = next + [existing]
+    end for
+    if not inserted then next = next + [candidate] end if
+    sorted = next
+  end for
+  return sorted
