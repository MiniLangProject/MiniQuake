-    while (mq_display_mode_count_value < MQ_DISPLAY_MODE_CAPACITY) {
-        memset(&mode, 0, sizeof(mode));
-        mode.dmSize = (WORD)sizeof(mode);
-        if (!EnumDisplaySettingsW(MQ_NULL, index, &mode)) {
-            break;
-        }
