+package miniquake.wad
+
+import miniquake.types as t
+import miniquake.byteio as bio
+import miniquake.array_util as arrayutil
+import miniquake.protocol_text as quakeText
+import std.fs as fs
+
+const CMP_NONE = 0
+const CMP_LZSS = 1
+
+const TYP_NONE = 0
+const TYP_LABEL = 1
+const TYP_LUMPY = 64
+const TYP_PALETTE = 64
+const TYP_QTEX = 65
+const TYP_QPIC = 66
+const TYP_SOUND = 67
+const TYP_MIPTEX = 68
