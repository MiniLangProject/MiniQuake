+    mq_joy_info.dwSize = (DWORD)sizeof(mq_joy_info);
+    mq_joy_info.dwFlags = MQ_JOY_RETURNALL | MQ_JOY_RETURNCENTERED;
+    return joyGetPosEx(mq_joy_id, &mq_joy_info) == MQ_JOYERR_NOERROR;
+}
