-    if (ChangeDisplaySettingsW(&mq_requested_display_mode, MQ_CDS_FULLSCREEN) != MQ_DISP_CHANGE_SUCCESSFUL) {
-        return 0;
-    }
-    mq_display_changed = 1;
-    mq_display_suspended = 0;
-    return 1;
-}
