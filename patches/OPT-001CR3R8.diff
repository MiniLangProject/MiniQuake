-            mq_mouse_ready = 0;
-            mq_update_clip_cursor();
-        }
-    }
-    if ((message == MQ_WM_KEYDOWN || message == MQ_WM_SYSKEYDOWN) && w_param < 256u) {
-        mq_u32 scan_code = ((mq_u32)l_param >> 16) & 0xFFu;
