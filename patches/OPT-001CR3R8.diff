+function KeyUp(button, key)
+  if key is void then
+    button[0] = 0
+    button[1] = 0
+    button[2] = 4
+    return true
+  end if
+  if button[0] == key then
+    button[0] = 0
+  else if button[1] == key then
+    button[1] = 0
+  else
+    return false
+  end if
+  if button[0] != 0 or button[1] != 0 then return false end if
+  if (button[2] & 1) == 0 then return false end if
+  button[2] = (button[2] & ~1) | 4
+  return true
