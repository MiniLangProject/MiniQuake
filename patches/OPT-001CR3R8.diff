-function fixedServerField(text, width)
-  source = bytes(text)
-  result = ""
-  index = 0
-  while index < width
-    if index < len(source) then result = result + menuNative.asciiChar(source[index]) else result = result + " " end if
-    index = index + 1
-  end while
-  return result
-end function
