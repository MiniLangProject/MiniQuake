+function nextEntityBuiltin(machine)
+  index = parmWord(machine, 0) + 1
+  limit = activeEdictLimit(machine)
+  while index < limit
+    if not machine.edictFree[index] then returnWord(machine, index); return true end if
+    index = index + 1
+  end while
+  returnWord(machine, 0)
+  return true
+end function
