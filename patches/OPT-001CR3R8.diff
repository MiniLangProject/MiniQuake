-    if (message == MQ_WM_KILLFOCUS && mq_display_fullscreen) {
-        ShowWindow(window, MQ_SW_SHOWMINNOACTIVE);
-        return 0;
-    }
-    return DefWindowProcW(window, message, w_param, l_param);
-}
