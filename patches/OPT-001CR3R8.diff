-static void mq_copy_c_string(char *destination, mq_u32 capacity, const char *source) {
-    mq_u32 index = 0;
-    if (capacity == 0) {
-        return;
-    }
-    if (source != MQ_NULL) {
-        while (index + 1u < capacity && source[index] != 0) {
-            destination[index] = source[index];
-            ++index;
-        }
-    }
-    destination[index] = 0;
-}
