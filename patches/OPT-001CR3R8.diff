+  bindKey("2", "impulse 2")
+  bindKey("3", "impulse 3")
+  bindKey("4", "impulse 4")
+  bindKey("5", "impulse 5")
+  bindKey("6", "impulse 6")
+  bindKey("7", "impulse 7")
+  bindKey("8", "impulse 8")
