+const PLAN_SEND_NOP = 2
+const PLAN_WAIT_SIGNON = 4
+const PLAN_RELIABLE_PHASE = 8
+
+const RELIABLE_NONE = 0
+const RELIABLE_DROP_OVERFLOW = 1
+const RELIABLE_WAIT = 2
+const RELIABLE_DROP_ASAP = 3
+const RELIABLE_SEND = 4
