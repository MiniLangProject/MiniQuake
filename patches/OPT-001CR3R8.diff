+function M_Quit_Key(state, key)
+  if key == menuKeys.K_ESCAPE or key == 110 or key == 78 then back(state); state.enterSound = true; return "cancel_quit" end if
+  if key == 121 or key == 89 then return "quit" end if
+  return "none"
+end function
