+MQ_EXPORT const char *mq_f32_to_text(mq_u32 bits) {
+    static char buffers[8][48];
+    static mq_u32 index = 0;
+    char *output;
+    index = (index + 1u) & 7u;
+    output = buffers[index];
+    sprintf(output, "%.9g", (double)mq_bits_to_float(bits));
+    return output;
+}
