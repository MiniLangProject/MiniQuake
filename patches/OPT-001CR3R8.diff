+  return t.Vec3(
+    soundCenterComponent(origin.x, minimum.x, maximum.x),
+    soundCenterComponent(origin.y, minimum.y, maximum.y),
+    soundCenterComponent(origin.z, minimum.z, maximum.z),
+  )
+end function
