+    'gamma 1',
+    'crosshair 0',
+    'gl_picmip 0',
+    'gl_polyblend 1',
+    'gl_ztrick 0',
+    'gl_clear 1',
+    'gl_finish 1',
+    ('timedemo ' + $Demo)
