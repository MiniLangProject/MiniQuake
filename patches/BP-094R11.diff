-
-$AllowedBuildExtensions = @(".log", ".json", ".txt", ".csv", ".mqtrace", ".md")
-$ForbiddenNames = @("pak0.pak", "pak1.pak", "progs.dat", "config.cfg", "autoexec.cfg", "gfx.wad", "glquake.exe", "opengl32.dll")
