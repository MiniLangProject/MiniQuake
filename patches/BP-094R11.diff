-$Staging = Join-Path $Build (".bp090-094r10-results-{0}" -f $Timestamp)
-$Archive = Join-Path $Build ("MiniQuake_BP-090-094R10_RESULTS_{0}.zip" -f $Timestamp)
-
-if (-not (Test-Path -LiteralPath $Build -PathType Container)) { throw "build directory does not exist: $Build" }
-if (Test-Path -LiteralPath $Staging) { Remove-Item -Recurse -Force -LiteralPath $Staging }
