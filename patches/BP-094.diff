+function Run-OriginalServerMiniClientPair([string]$Suffix, [int]$Port) {
+  $GameName = 'bp091_' + $Suffix
+  $GameDirectory = New-OriginalGameDirectory $GameName
+  $OriginalConsole = Join-Path $GameDirectory 'qconsole.log'
+  $OriginalServerOut = Join-Path $Build ("bp090-094-original-server-{0}-stdout.log" -f $Suffix)
+  $OriginalServerErr = Join-Path $Build ("bp090-094-original-server-{0}-stderr.log" -f $Suffix)
+  $OriginalServerArgs = Join-NativeArguments @(
+    '-dedicated', '4', '-basedir', $OriginalBase, '-game', $GameName,
+    '-condebug', '-nosound', '-nocdaudio', '-port', [string]$Port,
+    '+developer', '1', '+map', 'start'
+  )
+  Write-Host ("[MiniQuake] starting original GLQuake dedicated server {0} on UDP port {1}" -f $Suffix, $Port) -ForegroundColor Cyan
+  $OriginalServer = Start-BackgroundCapturedProcess -Executable $OriginalExe -ArgumentsText $OriginalServerArgs -Label ("original GLQuake dedicated server {0}" -f $Suffix)
+  try {
+    if (-not (Wait-ForFileText -Path $OriginalConsole -Pattern 'Server spawned\.' -TimeoutMilliseconds 20000)) {
+      if ($OriginalServer.process.HasExited) { throw "original GLQuake server $Suffix exited before map startup" }
+      throw "original GLQuake server $Suffix did not spawn start within 20 seconds"
+    }
+    $Prefix = Join-Path $Build ("bp090-094-miniquake-client-original-server-{0}" -f $Suffix)
+    [void](Run-Logged ("MiniQuake client to original GLQuake server {0}" -f $Suffix) $GameExe @(
+      '--original-interop-client', $QuakeBase, '127.0.0.1', [string]$Port,
+      [string]$OriginalInteropFrames, $Prefix, '-game', $Game
+    ) ("bp090-094-miniquake-client-original-server-{0}.log" -f $Suffix) 'result=PASS')
+    $SummaryPath = $Prefix + '-summary.json'
+    $Summary = Read-JsonFile $SummaryPath
+    if (-not $Summary.success -or -not $Summary.connected -or -not $Summary.spawned -or [int]$Summary.signon -ne 4 -or [int]$Summary.protocol -ne 15) {
+      throw "MiniQuake client/original server pair $Suffix did not prove complete Protocol-15 signon"
+    }
+    if (-not (Wait-ForFileText -Path $OriginalConsole -Pattern 'Client .* connected' -TimeoutMilliseconds 3000)) {
+      throw "original GLQuake server $Suffix did not log the MiniQuake client connection"
+    }
+    $Normalized = Join-Path $Build ("bp090-094-original-server-mini-client-{0}-normalized.json" -f $Suffix)
+    [void](Write-NormalizedInteropSummary -InputPath $SummaryPath -Direction 'original_server_mini_client' -OutputPath $Normalized)
+    return $Normalized
+  } finally {
+    Stop-OriginalDedicated -Handle $OriginalServer -StdoutPath $OriginalServerOut -StderrPath $OriginalServerErr
+    Copy-TextArtifact -Source $OriginalConsole -Destination (Join-Path $Build ("bp090-094-original-server-{0}-qconsole.log" -f $Suffix))
+  }
+}
