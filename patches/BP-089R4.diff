+def compiler() -> list[str] | None:
+    candidates = ([os.environ["CC"]] if os.environ.get("CC") else []) + ["cc", "gcc", "clang"]
+    for value in candidates:
+        parts = value.split()
+        if shutil.which(parts[0]):
+            return parts
+    return None
+
