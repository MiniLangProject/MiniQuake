+        "parent_package_id": PARENT,
+        "downstream_package": args.allow_downstream_package,
+        "fixed_six_formatter": formatter,
+        "ok": not errors,
+        "oracle": oracle_detail,
+        "rows": len(expected["rows"]),
+        "runtime_fixtures": 20,
+        "errors": errors,
