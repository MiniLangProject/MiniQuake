+    golden = root / GOLDEN
+    if args.write_golden:
+        golden.parent.mkdir(parents=True, exist_ok=True)
+        golden.write_text(json.dumps(expected, indent=2) + "\n", encoding="utf-8")
+
+    errors: list[str] = []
