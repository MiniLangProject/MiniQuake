+        "package_id": PACKAGE,
+        "parent_package_id": PARENT,
+        "sources": ["cmd.c", "cvar.c"],
+        "rows": rows(),
+        "reference": {"oracle": ORACLE, "oracle_sha256": sha(root / ORACLE)},
+    }
