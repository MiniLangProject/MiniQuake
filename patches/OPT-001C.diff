+import miniquake.build_info as buildInfo
+import miniquake.render.gl11 as gl
+
+opt001cPassed = 0
+opt001cFailed = 0
+
+function opt001cCheck(condition, label)
+  global opt001cPassed, opt001cFailed
+  if condition then
+    opt001cPassed = opt001cPassed + 1
+    print "[PASS] " + label
+  else
+    opt001cFailed = opt001cFailed + 1
+    print "[FAIL] " + label
+  end if
+end function
+
+function main(args)
+  opt001cCheck(buildInfo.OPTIMIZATION_STATUS == "opt001c_frame_allocation_candidate_v1", "optimization status")
+  opt001cCheck(buildInfo.OPTIMIZATION_FINGERPRINT == 0x1c001c03, "optimization fingerprint")
+  opt001cCheck(buildInfo.OPTIMIZATION_PARENT == "OPT-001B", "optimization parent")
+  opt001cCheck(not gl.traceEnabled(), "trace disabled initially")
+
+  gl.Trace_Begin()
