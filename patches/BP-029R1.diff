+def check_minilang_transitive_import_aliases(root: Path) -> CheckResult:
+    """Reject conflicting explicit aliases in a merged MiniLang import graph."""
+    src_root = root / "src"
+    source_files = sorted(src_root.rglob("*.ml"))
+    test_files = sorted((root / "tests").glob("*.ml")) if (root / "tests").is_dir() else []
+    package_pattern = re.compile(
+        r"(?m)^\s*package\s+([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)\s*$"
+    )
+    import_pattern = re.compile(
+        r"(?m)^\s*import\s+([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)"
+        r"(?:\s+as\s+([A-Za-z_][A-Za-z0-9_]*))?\s*$"
+    )
+    main_pattern = re.compile(r"(?m)^\s*function\s+main\s*\(")
+
+    packages: dict[str, Path] = {}
+    imports_by_file: dict[Path, list[tuple[str, str | None]]] = {}
+    clean_by_file: dict[Path, str] = {}
+    for path in source_files + test_files:
+        clean = strip_comments(path.read_text(encoding="utf-8"))
+        clean_by_file[path] = clean
+        imports_by_file[path] = import_pattern.findall(clean)
+        match = package_pattern.search(clean)
+        if match:
+            packages[match.group(1)] = path
+
+    entries: list[Path] = []
+    main_file = src_root / "main.ml"
+    if main_file.is_file():
+        entries.append(main_file)
+    entries.extend(path for path in test_files if main_pattern.search(clean_by_file[path]))
+
+    errors: list[str] = []
+    alias_bindings_checked = 0
+    largest_closure = 0
+    conflict_entries = 0
+    for entry in entries:
+        closure: set[Path] = set()
+        pending = [entry]
+        while pending:
+            current = pending.pop()
+            if current in closure:
+                continue
+            closure.add(current)
+            for package_name, _alias in imports_by_file.get(current, []):
+                imported = packages.get(package_name)
+                if imported is not None and imported not in closure:
+                    pending.append(imported)
+        largest_closure = max(largest_closure, len(closure))
+
+        aliases: dict[str, dict[str, list[str]]] = {}
+        for current in closure:
+            relative = current.relative_to(root).as_posix()
+            for package_name, alias in imports_by_file.get(current, []):
+                if not alias:
+                    continue
+                alias_bindings_checked += 1
+                aliases.setdefault(alias, {}).setdefault(package_name, []).append(relative)
+
+        has_conflict = False
+        for alias, targets in sorted(aliases.items()):
+            if len(targets) <= 1:
+                continue
+            has_conflict = True
+            origins = "; ".join(
+                f"{package_name} from {', '.join(sorted(set(paths)))}"
+                for package_name, paths in sorted(targets.items())
+            )
+            errors.append(
+                f"{entry.relative_to(root).as_posix()}: import alias '{alias}' "
+                f"refers to multiple packages: {origins}"
+            )
+        if has_conflict:
+            conflict_entries += 1
+
+    # Bind both aliases found by the first Windows build, including the second
+    # conflict that would otherwise only have appeared after the first fix.
+    try:
+        trace_text = (root / "tests/world_trace_parity_tests.ml").read_text(encoding="utf-8")
+        closure_text = (root / "tests/world_physics_closure_tests.ml").read_text(encoding="utf-8")
+        if "import miniquake.world_bsp as bspworld" not in trace_text:
+            errors.append("world trace fixture is missing the non-conflicting bspworld alias")
+        if "import miniquake.server_move as serverMovement" not in closure_text:
+            errors.append("world/physics closure fixture is missing the non-conflicting serverMovement alias")
+    except OSError as exc:
+        errors.append(f"cannot read alias hotfix fixtures: {exc}")
+
+    return CheckResult(
+        "minilang_transitive_import_aliases",
+        not errors,
+        {
+            "entrypoints_checked": len(entries),
+            "project_packages": len(packages),
+            "alias_bindings_checked": alias_bindings_checked,
+            "largest_import_closure": largest_closure,
+            "entries_with_conflicts": conflict_entries,
+        },
+        errors,
+    )
