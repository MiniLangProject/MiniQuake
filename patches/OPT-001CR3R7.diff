++function Remove-LoopbackFirewallRules {
++  foreach ($Name in $script:FirewallRules) {
++    Remove-NetFirewallRule -Name $Name -Confirm:$false -ErrorAction SilentlyContinue
++  }
++  if ($script:FirewallRules.Count -gt 0) {
