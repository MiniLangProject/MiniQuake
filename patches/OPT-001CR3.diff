+  polygonIndex = 0
+  while polygonIndex < len(polygons)
+    polygon = polygons[polygonIndex]
+    commands = arrayutil.makeEmptyArray(len(polygon))
+    vertexIndex = 0
+    while vertexIndex < len(polygon)
