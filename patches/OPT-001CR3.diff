diff --git a/mnt/data/_opt001cr3_release/root/tools/check_opt001cr3.py b/tools/check_opt001cr3.py
new file mode 100644
index 0000000..d0f156f
--- /dev/null
+++ b/tools/check_opt001cr3.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+import argparse, json, re
+from pathlib import Path
+
+def req(text, markers, label, errors):
+    for m in markers:
+        if m not in text: errors.append(f"{label} missing marker: {m}")
+
+def block(text,name):
+    m=re.search(rf"(?ms)^function(?:\s+inline)?\s+{re.escape(name)}\b.*?^end function$",text)
+    return m.group(0) if m else ""
+
+def main():
+    ap=argparse.ArgumentParser(); ap.add_argument('--root',default='.'); ap.add_argument('--json',default=''); a=ap.parse_args(); root=Path(a.root).resolve(); errors=[]
