@@ -0,0 +1,54 @@
+import miniquake.build_info as buildInfo
+import miniquake.array_util as arrays
+import miniquake.client_state as clientState
+import miniquake.server_state as serverState
+import miniquake.keys as keys
+import miniquake.sys_win as sysWin
+import miniquake.mathlib as math
+import miniquake.types as t
+
+passed = 0
+failed = 0
+
+function check(condition, label)
+  global passed, failed
+  if condition then
+    passed = passed + 1
+    print "[PASS] " + label
+  else
+    failed = failed + 1
+    print "[FAIL] " + label
+  end if
+end function
+
+function main(args)
+  check(buildInfo.OPTIMIZATION_STATUS == "opt001cr3_inline_array_hotpath_candidate_v1", "optimization status")
+  check(buildInfo.OPTIMIZATION_FINGERPRINT == 0x1c001c05, "optimization fingerprint")
+  check(buildInfo.OPTIMIZATION_PARENT == "OPT-001CR2", "optimization parent")
+
+  filled = arrays.makeFilledArray(5, 7)
+  check(len(filled) == 5, "filled array length")
+  check(filled[0] == 7 and filled[4] == 7, "filled array values")
+  empty = arrays.makeEmptyArray(3)
+  check(len(empty) == 3 and empty[0] is void and empty[2] is void, "empty array values")
+
+  stats = clientState.zeroStats(32)
+  check(len(stats) == 32 and stats[0] == 0 and stats[31] == 0, "zero stats exact allocation")
+  identity = keys.identityValues(8)
+  check(len(identity) == 8 and identity[0] == 0 and identity[7] == 7, "identity exact allocation")
+  server = serverState.create(4)
+  check(len(server.clients) == 4 and server.clients[0] is void, "server client exact allocation")
+  handles = sysWin.emptyHandles()
+  check(len(handles) == 10 and handles[0] == 0 and handles[9] == 0, "system handle exact allocation")
+
+  a = t.Vec3(1.0, 2.0, 3.0)
+  b = t.Vec3(4.0, 5.0, 6.0)
+  check(math.DotProduct(a, b) == 32.0, "inline dot product")
+
+  print "MiniQuake OPT-001CR3 hotpath tests passed: " + passed
+  if failed > 0 then
+    print "MiniQuake OPT-001CR3 hotpath tests failed: " + failed
+    return 1
+  end if
+  return 0
+end function
