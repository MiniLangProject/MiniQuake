+end function
+
+function shortHostName(text)
+  if numericHostName(text) then return text end if
+  source = bytes(text)
+  count = len(source)
+  if count > 15 then count = 15 end if
+  index = 0
+  while index < count
+    if source[index] == 46 then count = index; break end if
+    index = index + 1
+  end while
