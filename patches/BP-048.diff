+  printf("fnv_empty=%u\n", fnv(known, 0));
+  printf("fnv_known=%u\n", fnv(known, 9));
+  printf("rgba_hash=%u\n", fnv(rgba, 16));
+  printf("non_black=3\n");
+  printf("tga_bytes_2x2=30\n");
+  printf("fixtures=18\n");
+  return 0;
