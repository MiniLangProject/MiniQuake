+#include <stdint.h>
+#include <stdio.h>
+
+static uint32_t fnv(const unsigned char *data, int count) {
+  uint32_t hash = UINT32_C(2166136261);
+  int index;
+  for (index = 0; index < count; ++index) {
+    hash ^= data[index];
+    hash *= UINT32_C(16777619);
+  }
+  return hash;
+}
+
+int main(void) {
