+        ledger = json.loads((root / "BLOCK_LEDGER.json").read_text(encoding="utf-8"))
+        hotfix = json.loads((root / "docs/BP-045-049R2_HOTFIX_REPORT.json").read_text(encoding="utf-8"))
+
+        required_test_markers = (
+            "encoded = bytes(text)",
+            "bp048Equal(encoded[0], 123",
+            "bp048Equal(encoded[1], 34",
+            "bp048Equal(encoded[len(encoded) - 2], 125",
+            "bp048Equal(encoded[len(encoded) - 1], 10",
+        )
+        for item in required_test_markers:
+            if item not in test:
+                errors.append(f"BP-048 R2 fixture missing marker: {item}")
+        if re.search(r"\btext\s*\[\s*1\s*\]\s*==\s*34\b", test):
+            errors.append("BP-048 R2 fixture still compares a string element with byte value 34")
+        for item in ("encoded = bytes(text)", "string element directly with byte value 34"):
+            if item not in checker:
