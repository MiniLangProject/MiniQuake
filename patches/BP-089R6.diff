+function bp001TestSynchronizedEdictGcRoots()
+  entityCount = 96
+  game = serverRuntime.create(1)
+  machine = bp001MakeSyncMachine(entityCount)
+  runtime = serverRuntime.createEdictRuntime(entityCount, 1)
+  contextValue = serverRuntime.createQuakeCContext(game, void, void, void, runtime)
+  vm.setContext(machine, contextValue)
+  machine.edictFree = runtime.freeFlags
+  index = 0
+  while index < entityCount
+    runtime.freeFlags[index] = false
+    machine.edictFree[index] = false
+    index = index + 1
+  end while
+  bp001PopulateSyncMachine(machine, entityCount)
+  game.machine = machine
+  game.active = true
+
+  // Force collections inside the actual QuakeC-to-server mirror, not merely
+  // after a table of already-rooted Edicts has been constructed.
+  gc_set_limit(512)
+  pass = 0
+  while pass < 6
+    synchronizedCount = serverRuntime.syncQuakeCEdicts(game)
+    assertEqual(synchronizedCount, entityCount, "synchronized edict count")
+    gc_collect()
+    index = 0
+    while index < entityCount
+      item = game.edicts[index]
+      assertTrue(t.isVec3Value(item.origin), "synchronized origin root " + index)
+      assertTrue(t.isVec3Value(item.angles), "synchronized angles root " + index)
+      assertTrue(t.isVec3Value(item.velocity), "synchronized velocity root " + index)
+      assertTrue(t.isVec3Value(item.mins), "synchronized mins root " + index)
+      assertTrue(t.isVec3Value(item.maxs), "synchronized maxs root " + index)
+      assertTrue(t.isVec3Value(item.viewOffset), "synchronized view offset root " + index)
+      assertTrue(t.isVec3Value(item.baseline.origin), "synchronized baseline origin root " + index)
+      assertTrue(t.isVec3Value(item.baseline.angles), "synchronized baseline angles root " + index)
+      if index != 1 then
+        assertEqual(item.origin.x, index + 0.25, "synchronized origin value " + index)
+      end if
+      index = index + 1
+    end while
+    pass = pass + 1
+  end while
+  gc_set_limit(1048576)
+  serverRuntime.shutdown(game)
+  return true
+end function
