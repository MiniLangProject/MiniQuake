-function dropTimedOutClients(server, timeoutSeconds)
-  dropped = 0
-  for each client in server.clients
-    if client.active and netmain.NET_SocketTimedOut(client.socket, timeoutSeconds) then
-      dropClient(server, client, true)
-      dropped = dropped + 1
-    end if
-  end for
-  return dropped
-end function
