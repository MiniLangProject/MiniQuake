-function padFrag(value)
-  text = "" + native.trunc(value)
-  while len(bytes(text)) < 3
-    text = " " + text
-  end while
-  return text
-end function
-
-function fragGlyphs(value)
-  return slice(bytes(padFrag(value)), 0, 3)
-end function
