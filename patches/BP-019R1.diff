+def check_milestone_signon_phase_contract(root: Path) -> CheckResult:
+    """Keep the historical loopback test aligned with WinQuake host-frame phases.
+
+    BP-015 deliberately stopped transporting signon replies from inside the
+    parser.  CL_SignonReply/Host_* only queue reliable bytes; CL_SendCmd and
+    SV_SendClientMessages perform the actual transport later in the frame.
+    The old milestone fixture accidentally encoded the former immediate-send
+    shortcut, so this contract protects the source-guided phase boundaries.
+    """
+    errors: list[str] = []
+    details: dict[str, object] = {}
+    try:
+        milestone_text = (root / "tests/milestone_tests.ml").read_text(encoding="utf-8")
+        body = _function_body(milestone_text, "testLoopbackSignonHandshake")
+        if not body:
+            errors.append("testLoopbackSignonHandshake is missing from milestone_tests.ml")
+            return CheckResult("milestone_signon_phase_contract", False, details, errors)
+
+        ordered_markers = [
+            "client queues prespawn after signon one",
+            "server cannot consume prespawn before CL_SendCmd",
+            "client sends prespawn in CL_SendCmd phase",
+            "server consumes prespawn",
+            "server retains signon stage two until reliable phase",
+            "client cannot consume signon stage two before server reliable phase",
+            "server sends signon stage two in reliable phase",
+            "client queues name color and spawn",
+            "server cannot consume stage-two commands before CL_SendCmd",
+            "client sends stage-two commands in CL_SendCmd phase",
+            "server consumes name color and spawn",
+            "server retains signon stage three until reliable phase",
+            "client cannot consume signon stage three before server reliable phase",
+            "server sends signon stage three in reliable phase",
+            "client queues begin after signon three",
+            "server cannot consume begin before CL_SendCmd",
+            "client sends begin in CL_SendCmd phase",
+            "server consumes begin",
+            "server accepts begin without a stage-four packet",
+            "first fast update completes signon",
+        ]
+        positions: list[int] = []
+        for marker in ordered_markers:
+            position = body.find(marker)
+            positions.append(position)
+            if position < 0:
+                errors.append(f"loopback signon milestone is missing phase marker: {marker}")
+        present_positions = [position for position in positions if position >= 0]
+        if len(present_positions) == len(ordered_markers) and present_positions != sorted(present_positions):
+            errors.append("loopback signon phase markers are not in the required host-frame order")
+
+        send_cmd_calls = body.count("client.CL_SendCmd(")
+        server_reliable_calls = body.count("server.sendReliableMessages(")
+        early_server_guards = body.count("server cannot consume")
+        early_client_guards = body.count("client cannot consume")
+        if send_cmd_calls < 3:
+            errors.append(f"loopback signon milestone has {send_cmd_calls} CL_SendCmd calls; expected at least 3")
+        if server_reliable_calls < 3:
+            # Initial serverinfo plus signon stages two and three are all queued
+            # reliable payloads and must cross the explicit server send phase.
+            errors.append(
+                f"loopback signon milestone has {server_reliable_calls} server reliable-phase calls; expected at least 3"
+            )
+        if early_server_guards < 3:
+            errors.append("loopback signon milestone does not guard all three client-to-server queue boundaries")
+        if early_client_guards < 2:
+            errors.append("loopback signon milestone does not guard both server-to-client signon queue boundaries")
+
+        stale_sequence = re.search(
+            r'client\.pump\(localClient\).*?server\.pumpClientMessages\(localServer,\s*player\)',
+            body,
+            flags=re.S,
+        )
+        first_send = body.find("client.CL_SendCmd(")
+        if stale_sequence and stale_sequence.start() < first_send:
+            # The pre-send negative assertion is allowed and required.  Reject
+            # only the old positive assertion that expected immediate delivery.
+            segment = stale_sequence.group(0)
+            if 'expected 1' in segment or 'server consumes prespawn"' in segment:
+                errors.append("loopback signon milestone still expects parser-time prespawn transport")
+
+        details.update({
+            "ordered_phase_markers": len(ordered_markers),
+            "cl_sendcmd_calls": send_cmd_calls,
+            "server_reliable_phase_calls": server_reliable_calls,
+            "client_to_server_pre_send_guards": early_server_guards,
+            "server_to_client_pre_send_guards": early_client_guards,
+            "engine_sources_changed_by_hotfix": False,
+        })
+    except OSError as exc:
+        errors.append(f"cannot validate milestone signon phase contract: {exc}")
+    return CheckResult("milestone_signon_phase_contract", not errors, details, errors)
