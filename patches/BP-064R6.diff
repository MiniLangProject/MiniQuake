+            "server_exit_code = $ServerCode", "client_exit_code = $ClientCode", "INFRA_FAILURE:",
+        ):
+            if marker not in test_script:
+                errors.append(f"R6 runner missing process-lifecycle marker: {marker}")
+        if re.search(r"Start-Process\s+-FilePath\s+\$EvidenceExe", test_script, flags=re.I):
+            errors.append("R6 evidence server still uses Start-Process")
+        if re.search(r"\$ServerCode\s*=\s*\$Server\.ExitCode", test_script):
+            errors.append("R6 still reads the nullable R5 Start-Process ExitCode")
+
+        sequence = [
+            test_script.find("$Process.WaitForExit($TimeoutMilliseconds)"),
+            test_script.find("$Process.WaitForExit()", test_script.find("$Process.WaitForExit($TimeoutMilliseconds)") + 1),
+            test_script.find("$Process.Refresh()"),
+            test_script.find("$Code = [int]$Process.ExitCode"),
