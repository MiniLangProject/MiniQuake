+        if ids != ["BP-030", "BP-031", "BP-032", "BP-033", "BP-034"]:
+            errors.append(f"BLOCK_LEDGER.json step order differs: {ids!r}")
+        if ledger.get("block_runtime_fixtures") != 106:
+            errors.append("BLOCK_LEDGER.json fixture total differs from 106")
+        for package in ids:
+            patch = root / "patches" / f"{package}.diff"
+            if not patch.is_file() or patch.stat().st_size == 0:
+                errors.append(f"logical block patch is missing or empty: patches/{package}.diff")
+        golden = json.loads((root / "audit/host_lifecycle_closure_golden.json").read_text(encoding="utf-8"))
