+if (Test-Path -LiteralPath $Output) { Remove-Item -Force -LiteralPath $Output }
+Compress-Archive -Path (Join-Path $Staging "*") -DestinationPath $Output -CompressionLevel Optimal
+Remove-Item -Recurse -Force -LiteralPath $Staging
+
+Write-Host "MiniQuake $PackageId cumulative result archive created:"
+Write-Host "  $Output"
+Write-Host "No executables, DLLs or Quake game-data files were copied; their hashes are recorded instead."
+exit 0
