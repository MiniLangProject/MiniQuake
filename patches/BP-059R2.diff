+#include <stdint.h>
+#include <stdio.h>
+static int quake_atoi(const char *s) {
+    int sign=1, value=0;
+    if (*s=='-') { sign=-1; ++s; }
+    while (*s>='0' && *s<='9') { value=value*10+(*s-'0'); ++s; }
+    return value*sign;
+}
+int main(void) {
