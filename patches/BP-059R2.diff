+      $ScenarioPrefixA = Join-Path $EvidenceCorpusDirectory ($Scenario.name + "-a")
+      $ScenarioPrefixB = Join-Path $EvidenceCorpusDirectory ($Scenario.name + "-b")
+      $ScenarioLogA = Join-Path $BuildDirectory ("bp055-059r2-corpus-" + $Scenario.name + "-a.log")
+      $ScenarioLogB = Join-Path $BuildDirectory ("bp055-059r2-corpus-" + $Scenario.name + "-b.log")
+      Invoke-ExternalStep -Name ("render corpus " + $Scenario.name + " A") -Executable $GameExe -Arguments @("--render-evidence", $QuakeBase, $Scenario.map, [string]$Scenario.frame, $ScenarioPrefixA, "-game", $Game) -Detail "deterministic visible capture" -LogPath $ScenarioLogA
+      Invoke-ExternalStep -Name ("render corpus " + $Scenario.name + " B") -Executable $GameExe -Arguments @("--render-evidence", $QuakeBase, $Scenario.map, [string]$Scenario.frame, $ScenarioPrefixB, "-game", $Game) -Detail "independent deterministic visible capture" -LogPath $ScenarioLogB
