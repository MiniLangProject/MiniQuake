+            "WORLD_RENDER_STATUS": WORLD_RENDER_STATUS,
+            "MODEL_UI_RENDER_STATUS": MODEL_UI_RENDER_STATUS,
+            "RENDER_SPECIAL_STATUS": RENDER_SPECIAL_STATUS,
+            "COMPATIBILITY_PROFILE": "compat_109",
+            "NATIVE_TEXT_ABI": "caller_owned_bytes_v1",
+            "PROTOCOL_TEXT_ABI": "quake_latin1_cstring_v1",
