-function exactPrefix(text, prefix)
-  source = bytes(text)
-  wanted = bytes(prefix)
-  if len(wanted) > len(source) then return false end if
-  index = 0
-  while index < len(wanted)
-    if source[index] != wanted[index] then return false end if
-    index = index + 1
-  end while
-  return true
-end function
