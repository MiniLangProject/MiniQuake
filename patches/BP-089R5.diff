-function emptyAnimationTable(count)
-  result = arrayutil.makeEmptyArray(count)
-  index = 0
-  while index < count
-    // anim_total, anim_min, anim_max, anim_next, alternate_anims
-    result[index] = [0, 0, 0, -1, -1]
-    index = index + 1
-  end while
-  return result
-end function
