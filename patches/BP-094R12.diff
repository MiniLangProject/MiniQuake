+    pollProcedureList = arrayTail(pollProcedureList)
+    if item[0] == "slist_send" then Slist_Send() else if item[0] == "slist_poll" then Slist_Poll() end if
+    executed = executed + 1
+    SetNetTime()
+  end while
+  return executed
