+    if (-not [string]::IsNullOrWhiteSpace($StdLib)) { $Arguments += @("-StdLib", $StdLib) }
+    $Arguments += @("-Python", $PythonExe, "-Configuration", $Configuration)
+    if ($NetworkTests) { $Arguments += "-NetworkTests" }
