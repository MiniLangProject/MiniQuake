+
+function Read-QuakeCString([byte[]]$Data, [int]$Offset) {
+  $DataLength = 0
+  if ($null -ne $Data) { $DataLength = $Data.Length }
+  if ($null -eq $Data -or $Offset -lt 0 -or $Offset -ge $DataLength) {
+    throw ("invalid Quake string offset {0} for packet length {1}" -f $Offset, $DataLength)
+  }
+  $End = $Offset
+  while ($End -lt $Data.Length -and $Data[$End] -ne 0) { $End = $End + 1 }
+  if ($End -ge $Data.Length) { throw "unterminated Quake string in control packet" }
+  $Value = [Text.Encoding]::ASCII.GetString($Data, $Offset, $End - $Offset)
+  return [pscustomobject]@{
+    value = $Value
+    next_offset = $End + 1
+  }
+}
+
+function Get-AvailableLoopbackUdpPort([int]$Minimum, [int]$Maximum) {
+  if ($Minimum -lt 1 -or $Maximum -gt 65535 -or $Minimum -gt $Maximum) {
+    throw ("invalid UDP port range {0}..{1}" -f $Minimum, $Maximum)
+  }
+  for ($Attempt = 1; $Attempt -le 128; $Attempt++) {
+    $Candidate = Get-Random -Minimum $Minimum -Maximum ($Maximum + 1)
+    $Probe = $null
+    try {
+      $Probe = New-Object System.Net.Sockets.UdpClient
+      $Endpoint = New-Object System.Net.IPEndPoint -ArgumentList ([Net.IPAddress]::Parse('127.0.0.1')), $Candidate
+      $Probe.Client.Bind($Endpoint)
+      return $Candidate
+    } catch {
+      # A concurrently used port is simply skipped.
+    } finally {
+      if ($null -ne $Probe) { try { $Probe.Close() } catch { } }
+    }
+  }
+  throw ("INFRA_FAILURE: could not find a free loopback UDP port in range {0}..{1}" -f $Minimum, $Maximum)
+}
+
+function Wait-OriginalServerControlReady(
+  [pscustomobject]$Handle,
+  [string]$Suffix,
+  [int]$Port,
+  [int]$TimeoutMilliseconds,
+  [string]$ReportPath
+) {
+  # Quake control packet: NETFLAG_CTL | length(12), CCREQ_SERVER_INFO,
+  # "QUAKE\\0", NET_PROTOCOL_VERSION(3).  Waiting for CCREP_SERVER_INFO
+  # proves that the original process has completed WGL startup, opened the
+  # requested UDP accept socket and entered its network event loop.
+  [byte[]]$Request = @(0x80, 0x00, 0x00, 0x0c, 0x02, 0x51, 0x55, 0x41, 0x4b, 0x45, 0x00, 0x03)
+  $Started = [DateTime]::UtcNow
+  $Deadline = $Started.AddMilliseconds($TimeoutMilliseconds)
+  $Attempts = 0
+  $LastError = ''
+  $LastRemote = ''
+  $ResponseBytes = 0
+  $ServerAddress = ''
+  $HostName = ''
+  $MapName = ''
+  $CurrentPlayers = -1
+  $MaximumPlayers = -1
+  $Protocol = -1
+  $Ready = $false
+  $Udp = $null
+
+  Write-Host ("[MiniQuake] waiting for original GLQuake server {0} Protocol-3 readiness on 127.0.0.1:{1} (timeout {2} ms)" -f $Suffix, $Port, $TimeoutMilliseconds) -ForegroundColor Cyan
+
+  try {
+    $Udp = New-Object System.Net.Sockets.UdpClient
+    $Udp.Client.ReceiveTimeout = 750
+    $Target = New-Object System.Net.IPEndPoint -ArgumentList ([Net.IPAddress]::Parse('127.0.0.1')), $Port
+
+    while ([DateTime]::UtcNow -lt $Deadline -and -not $Ready) {
+      if ($Handle.process.HasExited) {
+        $Handle.process.WaitForExit()
+        $Handle.process.Refresh()
+        $LastError = "original process exited with code " + [int]$Handle.process.ExitCode
+        break
+      }
+
+      $Attempts = $Attempts + 1
+      try {
+        [void]$Udp.Send($Request, $Request.Length, $Target)
+        $Remote = New-Object System.Net.IPEndPoint -ArgumentList ([Net.IPAddress]::Any), 0
+        [byte[]]$Response = $Udp.Receive([ref]$Remote)
+        $LastRemote = $Remote.Address.ToString() + ':' + $Remote.Port
+        $ResponseBytes = $Response.Length
+        if ($Remote.Address.ToString() -ne '127.0.0.1' -or $Remote.Port -ne $Port) {
+          throw ("server-info response came from unexpected endpoint {0}" -f $LastRemote)
+        }
+
+        if ($Response.Length -lt 8) { throw "server-info response is too short" }
+        $WireLength = ([int]$Response[2] -shl 8) -bor [int]$Response[3]
+        if ($Response[0] -ne 0x80 -or $Response[1] -ne 0x00) { throw "response is not NETFLAG_CTL" }
+        if ($WireLength -ne $Response.Length) { throw ("response length field {0} does not match {1}" -f $WireLength, $Response.Length) }
+        if ($Response[4] -ne 0x83) { throw ("response command is 0x{0:x2}, expected CCREP_SERVER_INFO" -f $Response[4]) }
+
+        $Cursor = 5
+        $Field = Read-QuakeCString -Data $Response -Offset $Cursor
+        $ServerAddress = [string]$Field.value
+        $Cursor = [int]$Field.next_offset
+        $Field = Read-QuakeCString -Data $Response -Offset $Cursor
+        $HostName = [string]$Field.value
+        $Cursor = [int]$Field.next_offset
+        $Field = Read-QuakeCString -Data $Response -Offset $Cursor
+        $MapName = [string]$Field.value
+        $Cursor = [int]$Field.next_offset
+        if ($Cursor + 3 -gt $Response.Length) { throw "server-info response is truncated after map name" }
+        $CurrentPlayers = [int]$Response[$Cursor]
+        $MaximumPlayers = [int]$Response[$Cursor + 1]
+        $Protocol = [int]$Response[$Cursor + 2]
+        if ($Protocol -ne 3) { throw ("server-info control protocol is {0}, expected 3" -f $Protocol) }
+        if ([string]::IsNullOrWhiteSpace($MapName)) { throw "server-info response has no active map name" }
+        $Ready = $true
+      } catch [System.Net.Sockets.SocketException] {
+        # WSAETIMEDOUT is expected while the original process is still
+        # creating its window, OpenGL context and world textures.
+        $LastError = $_.Exception.Message
+      } catch {
+        $LastError = $_.Exception.Message
+      }
+
+      if (-not $Ready -and [DateTime]::UtcNow -lt $Deadline) {
+        Start-Sleep -Milliseconds 250
+      }
+    }
+  } finally {
+    if ($null -ne $Udp) { try { $Udp.Close() } catch { } }
+  }
+
+  $Elapsed = [int]([DateTime]::UtcNow - $Started).TotalMilliseconds
+  $ProcessAlive = $false
+  $ExitCode = $null
+  try {
+    $ProcessAlive = -not $Handle.process.HasExited
+    if (-not $ProcessAlive) {
+      $Handle.process.WaitForExit()
+      $Handle.process.Refresh()
+      $ExitCode = [int]$Handle.process.ExitCode
+    }
+  } catch { }
+
+  $Endpoints = @()
+  try {
+    if ($null -ne (Get-Command Get-NetUDPEndpoint -ErrorAction SilentlyContinue)) {
+      $Endpoints = @(
+        Get-NetUDPEndpoint -OwningProcess $Handle.process.Id -ErrorAction SilentlyContinue |
+          Select-Object LocalAddress, LocalPort
+      )
+    }
+  } catch { }
+
+  $Report = [ordered]@{
+    schema_version = 1
+    suffix = $Suffix
+    status = if ($Ready) { 'PASS' } else { 'FAIL' }
+    evidence = 'protocol3_server_info_response'
+    target_address = '127.0.0.1'
+    target_port = $Port
+    timeout_ms = $TimeoutMilliseconds
+    elapsed_ms = $Elapsed
+    probe_attempts = $Attempts
+    response_bytes = $ResponseBytes
+    response_remote = $LastRemote
+    server_address = $ServerAddress
+    hostname = $HostName
+    map = $MapName
+    current_players = $CurrentPlayers
+    maximum_players = $MaximumPlayers
+    control_protocol = $Protocol
+    process_id = $Handle.process.Id
+    process_alive = [bool]$ProcessAlive
+    process_exit_code = $ExitCode
+    process_udp_endpoints = $Endpoints
+    last_error = $LastError
+  }
+  $Report | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $ReportPath -Encoding UTF8
+
+  if (-not $Ready) {
+    throw ("INFRA_FAILURE: original GLQuake server {0} did not answer a Protocol-3 server-info probe on 127.0.0.1:{1} within {2} ms; report={3}" -f $Suffix, $Port, $TimeoutMilliseconds, $ReportPath)
+  }
+
+  Write-Host ("[MiniQuake] original GLQuake server {0} ready: probes={1} elapsed_ms={2} map={3} host={4} protocol={5}" -f $Suffix, $Attempts, $Elapsed, $MapName, $HostName, $Protocol) -ForegroundColor Green
+  return [pscustomobject]$Report
+}
+
+function Stop-OriginalServer([pscustomobject]$Handle, [string]$StdoutPath, [string]$StderrPath) {
+  try {
+    if (-not $Handle.process.HasExited) {
+      $Handle.process.StandardInput.WriteLine('quit')
+      $Handle.process.StandardInput.Flush()
+    }
+  } catch { }
+  $Exited = $false
+  try { $Exited = $Handle.process.WaitForExit(2500) } catch { }
+  if (-not $Exited) { Stop-BackgroundCapturedProcess $Handle }
+  else { $Handle.process.WaitForExit(); $Handle.process.Refresh() }
+  try {
+    $Stdout = [string]$Handle.stdout_task.Result
+    $Stderr = [string]$Handle.stderr_task.Result
+    [IO.File]::WriteAllText($StdoutPath, $Stdout, [Text.UTF8Encoding]::new($false))
+    [IO.File]::WriteAllText($StderrPath, $Stderr, [Text.UTF8Encoding]::new($false))
+  } catch { }
+  try { $Handle.process.Dispose() } catch { }
+}
