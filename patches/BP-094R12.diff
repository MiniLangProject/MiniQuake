+function compactActiveSockets()
+  global net_activeSockets
+  active = []
+  for each socket in net_activeSockets
+    if socket is not void and not socket.disconnected then active = active + [socket] end if
+  end for
+  net_activeSockets = active
+  return len(active)
+end function
