+  hostcache = networkState.hostCache
+  hostCacheCount = len(hostcache)
+  if SetNetTime() - slistStartTime < 1.5 then
+    SchedulePollProcedure("slist_poll", 0.1, void)
+    return true
+  end if
+  slistInProgress = false
+  slistSilent = false
+  slistLocal = true
+  return false
