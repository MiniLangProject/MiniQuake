+function Read-JsonFile([string]$Path) {
+  if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { throw "missing JSON report: $Path" }
+  return Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json
+}
