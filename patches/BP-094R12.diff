+  queuedBytes = 0
+  for each socket in net_activeSockets
+    queued = socketQueuedState(socket)
+    queuedMessages = queuedMessages + queued[0]
+    queuedBytes = queuedBytes + queued[1]
+  end for
+  return [
+    len(net_activeSockets),
+    len(net_freeSockets),
+    net_numsockets,
+    queuedMessages,
+    queuedBytes,
+    len(pollProcedureList),
+  ]
+end function
