+$Failure = ""
+try {
+  Write-Host "MiniQuake BP-090-094R12 acceptance test"
+  Write-Host "  parent: $BlockParentPackageId"
+  Write-Host "  root:   $Root"
+  if ($BisectOnFailure) { Write-Host "  logical bisect markers enabled" }
