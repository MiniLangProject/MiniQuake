+  setPhysicsBox(machine, 3, t.Vec3(15.0, 0.0, 0.0), t.Vec3(-1.0, -1.0, -1.0), t.Vec3(1.0, 1.0, 1.0), c.MOVETYPE_TOSS, c.SOLID_BBOX)
