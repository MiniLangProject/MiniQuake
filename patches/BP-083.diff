+# BP-083 black-port corpus
+
+Required deterministic scenarios:
+
+| Name | Map | Frames | Runs |
+|---|---|---:|---:|
+| start-064 | start | 64 | 2 |
+| e1m1-064 | e1m1 | 64 | 2 |
+| e1m2-064 | e1m2 | 64 | 2 |
+| e1m3-064 | e1m3 | 64 | 2 |
+
+Each pair must produce byte-identical `.mqtrace` files.
diff --git a/src/miniquake/black_port_corpus.ml b/src/miniquake/black_port_corpus.ml
new file mode 100644
index 0000000..33182d8
--- /dev/null
+++ b/src/miniquake/black_port_corpus.ml
@@ -0,0 +1,33 @@
+package miniquake.black_port_corpus
+
+const SCHEMA_VERSION = 1
+const FRAMES_PER_SCENARIO = 64
+const SCENARIO_COUNT = 4
+
+function scenarios()
+  return [
+    ["start-064", "start", 64],
+    ["e1m1-064", "e1m1", 64],
+    ["e1m2-064", "e1m2", 64],
+    ["e1m3-064", "e1m3", 64],
+  ]
+end function
+
+function scenarioAt(index)
+  values = scenarios()
+  if index < 0 or index >= len(values) then return error(8400, "black-port corpus scenario index out of range") end if
+  return values[index]
+end function
+
+function validate()
+  values = scenarios()
+  if SCHEMA_VERSION != 1 or len(values) != SCENARIO_COUNT then return false end if
+  index = 0
+  while index < len(values)
+    item = values[index]
+    if len(item) != 3 then return false end if
+    if item[2] != FRAMES_PER_SCENARIO then return false end if
+    index = index + 1
+  end while
+  return true
+end function
diff --git a/tests/black_port_corpus_tests.ml b/tests/black_port_corpus_tests.ml
new file mode 100644
index 0000000..b5ec26a
--- /dev/null
+++ b/tests/black_port_corpus_tests.ml
@@ -0,0 +1,84 @@
+package miniquake.tests.black_port_corpus
+
+import miniquake.black_port_corpus as corpus
+
+failures = 0
+checks = 0
+
+function check(condition, label)
+  global failures, checks
+  checks = checks + 1
+  if not condition then failures = failures + 1; print "FAIL: " + label end if
+end function
+
+function equal(actual, expected, label)
+  check(actual == expected, label + ": expected " + expected + ", got " + actual)
+end function
+
+function main(args)
+  global failures, checks
+  scenarios = corpus.scenarios()
+
+  print "[1/18] schema"
+  equal(corpus.SCHEMA_VERSION, 1, "schema")
+
+  print "[2/18] frame count"
+  equal(corpus.FRAMES_PER_SCENARIO, 64, "frames")
+
+  print "[3/18] scenario count"
+  equal(corpus.SCENARIO_COUNT, 4, "count")
+
+  print "[4/18] actual count"
+  equal(len(scenarios), 4, "actual count")
+
+  print "[5/18] start name"
+  equal(scenarios[0][0], "start-064", "start name")
+
+  print "[6/18] start map"
+  equal(scenarios[0][1], "start", "start map")
+
+  print "[7/18] start frames"
+  equal(scenarios[0][2], 64, "start frames")
+
+  print "[8/18] e1m1 name"
+  equal(scenarios[1][0], "e1m1-064", "e1m1 name")
+
+  print "[9/18] e1m1 map"
+  equal(scenarios[1][1], "e1m1", "e1m1 map")
+
+  print "[10/18] e1m2 name"
+  equal(scenarios[2][0], "e1m2-064", "e1m2 name")
+
+  print "[11/18] e1m2 map"
+  equal(scenarios[2][1], "e1m2", "e1m2 map")
+
+  print "[12/18] e1m3 name"
+  equal(scenarios[3][0], "e1m3-064", "e1m3 name")
+
+  print "[13/18] e1m3 map"
+  equal(scenarios[3][1], "e1m3", "e1m3 map")
+
+  print "[14/18] scenarioAt"
+  equal(corpus.scenarioAt(2)[1], "e1m2", "scenarioAt")
+
+  print "[15/18] negative index"
+  result = try(corpus.scenarioAt(-1))
+  check(result is error, "negative index rejected")
+
+  print "[16/18] upper index"
+  result = try(corpus.scenarioAt(4))
+  check(result is error, "upper index rejected")
+
+  print "[17/18] unique names"
+  check(scenarios[0][0] != scenarios[1][0] and scenarios[1][0] != scenarios[2][0] and scenarios[2][0] != scenarios[3][0], "unique names")
+
+  print "[18/18] corpus validation"
+  check(corpus.validate(), "corpus validation")
+
+  if failures > 0 then
+    print "MiniQuake BP-083 black-port corpus tests failed: " + failures + "/" + checks
+    return 1
+  end if
+  print "MiniQuake BP-083 black-port corpus tests passed: 18"
+  return 0
+end function
diff --git a/tools/check_source_083.py b/tools/check_source_083.py
new file mode 100755
index 0000000..d683dd5
--- /dev/null
+++ b/tools/check_source_083.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+import argparse, json, pathlib, sys
+
+EXPECTED = [
+    {"name": "start-064", "map": "start", "frames": 64},
+    {"name": "e1m1-064", "map": "e1m1", "frames": 64},
+    {"name": "e1m2-064", "map": "e1m2", "frames": 64},
+    {"name": "e1m3-064", "map": "e1m3", "frames": 64},
+]
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--root", default=".")
+    ap.add_argument("--json", default="")
+    ns = ap.parse_args()
+    root = pathlib.Path(ns.root).resolve()
+    errors = []
+    golden = json.loads((root / "audit/black_port_corpus_golden.json").read_text())
+    source = (root / "src/miniquake/black_port_corpus.ml").read_text(encoding="utf-8-sig")
+    test = (root / "tests/black_port_corpus_tests.ml").read_text(encoding="utf-8-sig")
+
+    if golden.get("scenarios") != EXPECTED:
+        errors.append("scenario corpus differs")
+    if golden.get("required_processes_per_scenario") != 2:
+        errors.append("two-process requirement missing")
+    if golden.get("required_comparison") != "byte-identical mqtrace":
+        errors.append("byte-identical trace requirement missing")
+    for item in EXPECTED:
+        for value in (item["name"], item["map"]):
+            if f'"{value}"' not in source:
+                errors.append("source corpus missing: " + value)
+    if "const SCENARIO_COUNT = 4" not in source or "const FRAMES_PER_SCENARIO = 64" not in source:
+        errors.append("source corpus constants missing")
+    if "MiniQuake BP-083 black-port corpus tests passed: 18" not in test:
+        errors.append("runtime success marker missing")
+
+    report = {
+        "schema_version": 1,
+        "package": "BP-083",
+        "status": "PASS" if not errors else "FAIL",
+        "errors": errors,
+        "scenarios": EXPECTED,
+        "fixtures": 18,
+    }
+    if ns.json:
+        pathlib.Path(ns.json).write_text(json.dumps(report, indent=2) + "\n")
+    print("MiniQuake BP-083 black-port corpus verification: " + report["status"])
+    for error in errors:
+        print("  [FAIL] " + error)
+    return 0 if not errors else 1
+
+if __name__ == "__main__":
+    sys.exit(main())
