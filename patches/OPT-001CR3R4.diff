+  ) "opt001cr3r4-e1m2-visible.log")
+
+  [void](Invoke-Live "OPT-001CR3R4 e1m2 headless validation" $GameExe @(
+    "--runtime-smoke", $QuakeBase, "e1m2", [string]$E1M2HeadlessFrames, "-game", $Game
+  ) "opt001cr3r4-e1m2-headless.log")
+
+  $TransitionPrefix = Join-Path $Build "opt001cr3r4-transition"
+  [void](Invoke-Live "OPT-001CR3R4 e1m1-e1m2-e1m1 transition" $GameExe @(
+    "--opt001b-transition", $QuakeBase, [string]$TransitionFrames, $TransitionPrefix, "-game", $Game
+  ) "opt001cr3r4-transition.log")
+
+  $PlateauPrefix = Join-Path $Build "opt001cr3r4-listen-handle-plateau"
