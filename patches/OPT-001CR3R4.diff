+PACKAGE_RE = re.compile(r"(?m)^\s*package\s+([A-Za-z_][A-Za-z0-9_.]*)\s*$")
+MAIN_RE = re.compile(r"(?m)^\s*function\s+main\s*\(\s*args\s*\)")
