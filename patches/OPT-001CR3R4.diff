+  ) "opt001cr3r4-handle-plateau.log" -AllowFailure)
+
+  [void](Invoke-Live "OPT-001CR3R4 aggregate analysis" $PythonExe @(
+    (Join-Path $Root "tools\analyze_opt001a.py"), "--build", $Build,
+    "--prefix", "opt001cr3r4", "--next-revision", "OPT-001D",
+    "--json", (Join-Path $Build "opt001cr3r4-baseline-summary.json"),
+    "--markdown", (Join-Path $Build "opt001cr3r4-baseline-summary.md")
+  ) "opt001cr3r4-aggregate-analysis.log" -AllowFailure)
+
+  $PerformanceJson = Join-Path $Build "opt001cr3r4-performance-comparison.json"
+  [void](Invoke-Live "OPT-001CR3R4 performance comparison" $PythonExe @(
+    (Join-Path $Root "tools\compare_opt001c_performance.py"),
+    "--baseline", (Join-Path $Root "audit\opt001b_performance_baseline.json"),
+    "--build", $Build,
