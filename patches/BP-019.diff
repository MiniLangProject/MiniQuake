+    print(f"  rows={len(expected_golden['rows'])} runtime_fixtures={RUNTIME_FIXTURES} "
+          f"components={len(components)} fingerprint=0x{fingerprint():08x} oracle={oracle_detail}")
+    for error in errors:
+        print("  ERROR: " + error)
