+    "Compatibility profile: compat_109",
+    "Native text ABI: $NativeTextAbi",
+    "Protocol text ABI: $ProtocolTextAbi",
+    "Block: $BlockId",
+    "Block parent package: $BlockParentPackageId",
+    "Protocol status: $ProtocolStatus"
