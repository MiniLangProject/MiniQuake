+  $VersionOutput | ForEach-Object { Write-Host $_ }
+  if ($VersionExitCode -ne 0) { throw "MiniQuake --version failed with exit code $VersionExitCode." }
+  $VersionText = $VersionOutput -join "`n"
+  foreach ($Marker in @(
+    "Package: $PackageId",
