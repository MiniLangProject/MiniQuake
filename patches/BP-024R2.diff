-function newString(text)
-  source = protocolText.encodeBytes(text)
-  output = bytes(len(source))
-  sourceIndex = 0
-  outputIndex = 0
-  while sourceIndex < len(source)
-    if source[sourceIndex] == 92 and sourceIndex + 1 < len(source) then
