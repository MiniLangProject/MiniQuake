+function trimTrailingSpaces(text)
+  data = bytes(text)
+  count = len(data)
+  while count > 0 and data[count - 1] == 32
+    count = count - 1
+  end while
+  if count == len(data) then return text end if
+  return decode(slice(data, 0, count))
