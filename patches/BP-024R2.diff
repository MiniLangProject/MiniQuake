+function testGlobalOffset()
+  data = fixture()
+  bio.putU16(data, bio.i32(data, 16) + 10, 32)
+  program = progs.parse(data, "bad-global-offset.dat")
+  yes(try(progs.validateProgram(program)) is error, "global range rejected by strict audit")
+  return true
+end function
