+function testFieldSaveGlobal()
+  data = fixture()
+  bio.putU16(data, bio.i32(data, 24) + 8, c.EV_FLOAT | c.DEF_SAVEGLOBAL)
+  yes(try(progs.parse(data, "bad-field-save.dat")) is error, "field DEF_SAVEGLOBAL rejected")
+  return true
+end function
