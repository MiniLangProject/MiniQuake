+  include = include and not wordsAreZero(words, definition.offset, size)
+  if not include then return text end if
+  serialized = try(valueString(machine, definition.type, words, definition.offset, true))
+  if serialized is error then return serialized end if
+  return appendQuotedPair(text, definition.name, serialized)
+end function
