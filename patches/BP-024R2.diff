+  }
+
+  $CanUseGameData = -not $SkipGameValidation -and -not [string]::IsNullOrWhiteSpace($QuakeBase)
+  if (-not $CanUseGameData) {
+    $Reason = if ($SkipGameValidation) { "-SkipGameValidation" } else { "no -QuakeBase supplied" }
+    Add-StepResult "[BP-024R2] stock progs.dat compatibility gate" "SKIPPED" 0 $Reason
+    Add-StepResult "[BP-024R2] installed Quake data validation" "SKIPPED" 0 $Reason
+    Add-StepResult "[BP-024R2] headless runtime validation" "SKIPPED" 0 $Reason
+  } else {
