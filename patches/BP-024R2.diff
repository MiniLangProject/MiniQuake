+
+function integerNamedOption(arguments, name, fallback, minimum, maximum)
+  index = 1
+  while index + 1 < len(arguments)
+    if bio.lower(arguments[index]) == name then
+      return boundedInteger(arguments[index + 1], fallback, minimum, maximum)
+    end if
+    index = index + 1
+  end while
+  return fallback
+end function
