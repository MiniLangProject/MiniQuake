+function makeMachine()
+  dummy = t.QuakeCFunction(0, 0, 0, 0, "", "", 0, array(8, 0))
+  spawnfn = t.QuakeCFunction(0, 0, 0, 0, "spawnfn", "fixture.qc", 0, array(8, 0))
