+  index = 1
+  while index < len(machine.program.fieldDefs)
+    nextText = try(appendEdictDefinition(machine, machine.edicts[entityIndex], machine.program.fieldDefs[index], text))
+    if nextText is error then return nextText end if
+    text = nextText
+    index = index + 1
+  end while
+  return text + "}\n"
+end function
