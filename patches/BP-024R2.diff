-function quotedPairLine(name, value)
-  if name is void then return error(2610, "QuakeC serialization received a void field name") end if
-  if value is void then return error(2611, "QuakeC serialization received a void field value: " + name) end if
-  line = "\""
-  line = line + name
-  line = line + "\" \""
-  line = line + value
-  line = line + "\"\n"
-  return line
