+    }
+    if (-not $SummaryA.ok -or -not $SummaryB.ok) { throw "A trace summary reports failure." }
+    if ([int]$SummaryA.frames_written -ne $TraceFrames -or [int]$SummaryB.frames_written -ne $TraceFrames) {
