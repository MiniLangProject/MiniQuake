@@ -0,0 +1,118 @@
+package miniquake.tests.cd_audio_source_surface
+
+import miniquake.sound.cd_audio as cd
+
+failures = 0
+checks = 0
+
+function check(condition, label)
+  global failures, checks
+  checks = checks + 1
+  if not condition then
+    failures = failures + 1
+    print "FAIL: " + label
+  end if
+end function
+
+function equal(actual, expected, label)
+  check(actual == expected, label + ": expected " + expected + ", got " + actual)
+end function
+
+function main(args)
+  global failures, checks
+  state = cd.create(void, 12)
+
+  print "[1/20] initialization"
+  equal(cd.CDAudio_Init(state), 0, "init result")
+  check(state.initialized and state.enabled and state.valid, "init flags")
+
+  print "[2/20] disk info"
+  equal(cd.CDAudio_GetAudioDiskInfo(state), 0, "disk info")
+  equal(state.maxTrack, 12, "max track")
+
+  print "[3/20] close door"
+  check(cd.CDAudio_CloseDoor(state), "close door")
+  check(len(bytes(state.lastMessage)) > 0, "close door message")
+
+  print "[4/20] play"
+  state.volume = 1.0
+  check(cd.CDAudio_Play(state, 3, false), "play")
+  equal(state.track, 3, "play track")
+
+  print "[5/20] successful completion"
+  equal(cd.CDAudio_MessageHandler(state, cd.MCI_NOTIFY_SUCCESSFUL, true), 0, "notify success")
+  check(not state.playing, "success clears playing")
+
+  print "[6/20] looping completion"
+  check(cd.CDAudio_Play(state, 4, true), "loop play")
+  equal(cd.CDAudio_MessageHandler(state, cd.MCI_NOTIFY_SUCCESSFUL, true), 0, "loop notify")
+  check(state.playing and state.looping, "loop restarts")
+
+  print "[7/20] superseded notification"
+  equal(cd.CDAudio_MessageHandler(state, cd.MCI_NOTIFY_SUPERSEDED, true), 0, "superseded")
+
+  print "[8/20] aborted notification"
+  equal(cd.CDAudio_MessageHandler(state, cd.MCI_NOTIFY_ABORTED, true), 0, "aborted")
+
+  print "[9/20] foreign device"
+  equal(cd.CDAudio_MessageHandler(state, cd.MCI_NOTIFY_SUCCESSFUL, false), 1, "foreign device")
+
+  print "[10/20] unknown notification"
+  equal(cd.CDAudio_MessageHandler(state, 99, true), 1, "unknown notify")
+  check(len(bytes(state.lastMessage)) > 0, "unknown message")
+
+  print "[11/20] failure notification"
+  state.valid = true
+  state.playing = true
+  equal(cd.CDAudio_MessageHandler(state, cd.MCI_NOTIFY_FAILURE, true), 0, "failure notify")
+  check(not state.valid and not state.playing, "failure state")
+
+  print "[12/20] disk revalidation"
+  equal(cd.CDAudio_GetAudioDiskInfo(state), 0, "revalidate")
+  check(state.valid, "revalidated")
+
+  print "[13/20] eject"
+  state.playing = true
+  check(cd.CDAudio_Eject(state), "eject")
+  check(not state.valid and not state.playing, "eject state")
+
+  print "[14/20] play rejected without media"
+  check(not cd.CDAudio_Play(state, 1, false), "invalid media reject")
+
+  print "[15/20] close command"
+  cd.CD_f(state, ["cd", "close"])
+  check(len(bytes(state.lastMessage)) > 0, "close command")
+
+  print "[16/20] reset command"
+  cd.CD_f(state, ["cd", "reset"])
+  check(state.valid and state.enabled, "reset state")
+
+  print "[17/20] eject command"
+  cd.CD_f(state, ["cd", "eject"])
+  check(not state.valid, "eject command state")
+
+  print "[18/20] invalid disk info"
+  empty = cd.create(void, 1)
+  empty.maxTrack = 0
+  empty.initialized = true
+  equal(cd.CDAudio_GetAudioDiskInfo(empty), -1, "empty media")
+  check(not empty.valid, "empty invalid")
+
+  print "[19/20] identity remap"
+  remap = cd.identityRemap()
+  equal(remap[0], 0, "remap zero")
+  equal(remap[99], 99, "remap ninety-nine")
+
+  print "[20/20] shutdown"
+  state.valid = true
+  state.playing = true
+  check(cd.CDAudio_Shutdown(state), "shutdown")
+  check(not state.playing, "shutdown stops")
+
+  if failures > 0 then
+    print "MiniQuake BP-081 CD audio source-surface tests failed: " + failures + "/" + checks
+    return 1
+  end if
+  print "MiniQuake BP-081 CD audio source-surface tests passed: 20"
+  return 0
+end function
