new file mode 100755
index 0000000..a2e2b98
--- /dev/null
+++ b/tools/check_network_061.py
@@ -0,0 +1,18 @@
+#!/usr/bin/env python3
+import argparse,json,pathlib,sys
+
+def main():
+ p=argparse.ArgumentParser();p.add_argument('--root',default='.');p.add_argument('--json',default='');a=p.parse_args();r=pathlib.Path(a.root).resolve();e=[]
+ loop=(r/'src/miniquake/net_loop.ml').read_text(encoding='utf-8-sig'); ctl=(r/'src/miniquake/net_control.ml').read_text(encoding='utf-8-sig'); t=(r/'tests/network_control_parity_tests.ml').read_text(encoding='utf-8-sig'); g=json.loads((r/'audit/network_control_golden.json').read_text())
+ for m in ['const HOST_CACHE_SIZE = 8','len(result) < HOST_CACHE_SIZE','function uniqueHostName','function connectionRequestAction']:
+  if m not in loop:e.append('net_loop missing '+m)
+ for m in ['const NET_PROTOCOL_VERSION = 3','const GAME_NAME = "QUAKE"','function requestConnect','function replyServerInfo']:
+  if m not in ctl:e.append('net_control missing '+m)
+ if 'passed: 24' not in t:e.append('fixture marker missing')
+ if g.get('fixtures')!=24 or g.get('host_cache_size')!=8:e.append('golden mismatch')
+ out={'schema_version':1,'package':'BP-061','status':'PASS' if not e else 'FAIL','errors':e,'fixtures':24,'host_cache_size':8}
+ if a.json:pathlib.Path(a.json).write_text(json.dumps(out,indent=2)+'\n')
+ print('MiniQuake BP-061 network control verification: '+out['status'])
+ for x in e:print('  [FAIL] '+x)
+ return 0 if not e else 1
+if __name__=='__main__':sys.exit(main())
