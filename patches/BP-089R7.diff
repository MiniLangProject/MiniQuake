+function synchronizedVectorTarget(value, entityIndex, fieldName, x, y, z)
+  if t.isVec3Value(value) then return value end if
+  created = t.Vec3(x, y, z)
+  return requireSynchronizedVector(created, entityIndex, fieldName)
