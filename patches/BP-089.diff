+  [ValidateRange(1, 1000000)]
+  [int]$BlackPortCorpusFrames = 64,
+  [ValidateRange(1, 1000000)]
+  [int]$RenderEvidenceFrame = 128,
+  [ValidateRange(1, 2000000000)]
+  [int]$SoakFrames = 5000,
