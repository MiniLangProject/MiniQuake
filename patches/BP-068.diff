+#include <stdio.h>
+static double clamp(double x,double lo,double hi){return x<lo?lo:(x>hi?hi:x);}
+int main(void) {
+  printf("cd_down=%.1f\n", clamp(1.0-1.0,0.0,1.0));
+  printf("cd_up=%.1f\n", clamp(0.0+1.0,0.0,1.0));
+  printf("sound_up=%.1f\n", clamp(0.7+0.1,0.0,1.0));
+  printf("submenu_toggle=main\n");
+  return 0;
+}
