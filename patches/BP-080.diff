@@ -0,0 +1,118 @@
+package miniquake.tests.cvar_source_surface
+
+import miniquake.cvar as cvars
+import miniquake.types as t
+import miniquake.native as native
+
+failures = 0
+checks = 0
+
+function check(condition, label)
+  global failures, checks
+  checks = checks + 1
+  if not condition then
+    failures = failures + 1
+    print "FAIL: " + label
+  end if
+end function
+
+function equal(actual, expected, label)
+  check(actual == expected, label + ": expected " + expected + ", got " + actual)
+end function
+
+function commandExists(name)
+  return name == "echo"
+end function
+
+function main(args)
+  global failures, checks
+
+  registry = cvars.createRegistry()
+  alpha = cvars.create("alpha", "1", true, false)
+  server = cvars.create("server_value", "2", false, true)
+
+  print "[1/20] find missing"
+  check(cvars.Cvar_FindVar(registry, "alpha") is void, "missing variable")
+
+  print "[2/20] register alpha"
+  result = cvars.Cvar_RegisterVariable(registry, alpha, commandExists)
+  check(result[0], "register alpha")
+
+  print "[3/20] find alpha"
+  check(cvars.Cvar_FindVar(registry, "alpha") == alpha, "find alpha")
+
+  print "[4/20] duplicate registration"
+  duplicate = cvars.Cvar_RegisterVariable(registry, alpha, commandExists)
+  check(not duplicate[0], "duplicate rejected")
+
+  print "[5/20] command collision"
+  echoVariable = cvars.create("echo", "1", false, false)
+  collision = cvars.Cvar_RegisterVariable(registry, echoVariable, commandExists)
+  check(not collision[0], "command collision rejected")
+
+  print "[6/20] variable value"
+  equal(native.floatBits(cvars.Cvar_VariableValue(registry, "alpha")), native.floatBits(1.0), "alpha numeric")
+
+  print "[7/20] missing value"
+  equal(native.floatBits(cvars.Cvar_VariableValue(registry, "missing")), native.floatBits(0.0), "missing numeric")
+
+  print "[8/20] variable string"
+  equal(cvars.Cvar_VariableString(registry, "alpha"), "1", "alpha string")
+
+  print "[9/20] missing string"
+  equal(cvars.Cvar_VariableString(registry, "missing"), "", "missing string")
+
+  print "[10/20] completion"
+  equal(cvars.Cvar_CompleteVariable(registry, "al"), "alpha", "completion")
+
+  print "[11/20] empty completion"
+  check(cvars.Cvar_CompleteVariable(registry, "") is void, "empty completion")
+
+  print "[12/20] set"
+  setResult = cvars.Cvar_Set(registry, "alpha", "3.5")
+  check(setResult[0], "set alpha")
+  equal(cvars.Cvar_VariableString(registry, "alpha"), "3.5", "set string")
+
+  print "[13/20] set missing"
+  missingSet = cvars.Cvar_Set(registry, "missing", "7")
+  check(not missingSet[0], "missing set non-fatal")
+
+  print "[14/20] set value formatting"
+  setValueResult = cvars.Cvar_SetValue(registry, "alpha", 0.8)
+  check(setValueResult[0], "set value")
+  equal(cvars.Cvar_VariableString(registry, "alpha"), "0.800000", "set value text")
+
+  print "[15/20] register server cvar"
+  check(cvars.Cvar_RegisterVariable(registry, server, commandExists)[0], "register server")
+
+  print "[16/20] server change"
+  check(cvars.Cvar_Set(registry, "server_value", "4")[0], "set server")
+  changes = cvars.takeServerChanges(registry)
+  equal(len(changes), 1, "server changes")
+  equal(changes[0][0], "server_value", "server change name")
+
+  print "[17/20] command query"
+  query = cvars.Cvar_Command(registry, ["alpha"])
+  check(query[0], "command handled")
+  check(len(bytes(query[1])) > 0, "command query output")
+
+  print "[18/20] command set"
+  commandSet = cvars.Cvar_Command(registry, ["alpha", "9"])
+  check(commandSet[0], "command set handled")
+  equal(cvars.Cvar_VariableString(registry, "alpha"), "9", "command set value")
+
+  print "[19/20] non-cvar command"
+  notHandled = cvars.Cvar_Command(registry, ["unknown"])
+  check(not notHandled[0], "unknown command")
+
+  print "[20/20] archive output"
+  archive = cvars.Cvar_WriteVariables(registry)
+  check(archive == "alpha \"9\"\n", "archive text")
+
+  if failures > 0 then
+    print "MiniQuake BP-080 cvar source-surface tests failed: " + failures + "/" + checks
+    return 1
+  end if
+  print "MiniQuake BP-080 cvar source-surface tests passed: 20"
+  return 0
+end function
