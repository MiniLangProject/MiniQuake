+function DrawTextureChains()
+  global skychain, rCompatTextureChains
+  if rCompatRenderer is void then return 0 end if
+  if not rCompatTextureSort then
+    GL_DisableMultitexture()
+    count = 0
+    if len(skychain) > 0 then
