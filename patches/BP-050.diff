+function R_DrawWorld()
+  global lightmap_polys, skychain, waterchain
+  if rCompatRenderer is void or len(rCompatRenderer.map.models) == 0 then return 0 end if
+  gl.colorFloat(1.0, 1.0, 1.0, 1.0)
