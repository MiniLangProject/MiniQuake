+
+function R_ClearProduction()
+  global rCompatTrickFrame, rCompatDepthMin, rCompatDepthMax, rCompatLastClearPlan
+  plan = specialPaths.clearPlan(rCompatMirrorAlpha, rCompatClearColor, rCompatZTrick, rCompatTrickFrame)
