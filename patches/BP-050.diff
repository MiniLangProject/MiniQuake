+  gl.begin(gl.GL_POLYGON)
+  for each vertex in surface.vertices
+    gl.texcoord2(vertex.lightS, vertex.lightT)
+    gl.vertex3(vertex.position.x, vertex.position.y, vertex.position.z)
+  end for
+  gl.finishPrimitive()
+end function
