+    end if
+    return count
+  end if
+
+  count = 0
+  textureIndex = 0
+  while textureIndex < len(rCompatTextureChains)
+    chain = rCompatTextureChains[textureIndex]
+    if len(chain) > 0 then
+      first = chain[0]
+      if (first.flags & c.SURF_DRAWSKY) != 0 then
+        R_DrawSkyChain(chain)
+        count = count + len(chain)
