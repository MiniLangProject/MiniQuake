+def check_quakec_closure_contract(root: Path) -> CheckResult:
+    """Run all five QuakeC component checkers and bind the BP-020..024 ledger."""
+    errors: list[str] = []
+    details: dict[str, object] = {}
+    checkers = [
+        "check_quakec_progs.py", "check_quakec_vm.py", "check_quakec_edict.py",
+        "check_quakec_builtins.py", "check_quakec_closure.py",
+    ]
+    try:
+        for checker in checkers:
+            completed = subprocess.run(
+                [sys.executable, str(root / "tools" / checker), "--root", str(root)],
+                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=90, check=False,
+            )
+            if completed.returncode != 0:
+                errors.append(f"{checker} failed: {completed.stdout.strip()}")
+        ledger = json.loads((root / "BLOCK_LEDGER.json").read_text(encoding="utf-8"))
+        if ledger.get("block_id") != BLOCK_ID or ledger.get("parent_package_id") != BLOCK_PARENT_PACKAGE_ID:
+            errors.append("BLOCK_LEDGER.json has inconsistent QuakeC block lineage")
+        if ledger.get("final_package_id") != PACKAGE_ID or ledger.get("quakec_status") != QUAKEC_STATUS:
+            errors.append("BLOCK_LEDGER.json has inconsistent final package or QuakeC status")
+        steps = ledger.get("steps") if isinstance(ledger.get("steps"), list) else []
+        ids = [item.get("package_id") for item in steps if isinstance(item, dict)]
+        if ids != ["BP-020", "BP-021", "BP-022", "BP-023", "BP-024"]:
+            errors.append(f"BLOCK_LEDGER.json step order differs: {ids!r}")
+        if ledger.get("block_runtime_fixtures") != 98 or ledger.get("stock_runtime_gates") != 1:
+            errors.append("BLOCK_LEDGER.json QuakeC fixture totals differ")
+        for package in ("BP-020", "BP-021", "BP-022", "BP-023", "BP-024"):
+            patch = root / "patches" / f"{package}.diff"
+            if not patch.is_file() or patch.stat().st_size == 0:
+                errors.append(f"logical block patch is missing or empty: patches/{package}.diff")
+        closure = json.loads((root / "audit/quakec_closure_golden.json").read_text(encoding="utf-8"))
+        if closure.get("status") != QUAKEC_STATUS:
+            errors.append("QuakeC closure golden status differs")
+        rows = closure.get("rows") if isinstance(closure.get("rows"), list) else []
+        values = {row.get("name"): row.get("value") for row in rows if isinstance(row, dict)}
+        if values.get("contract_fingerprint") != 0xBC89CBF1:
+            errors.append("QuakeC contract fingerprint differs from 0xbc89cbf1")
+        details.update({
+            "component_checkers": len(checkers),
+            "steps": len(steps),
+            "runtime_fixtures": ledger.get("block_runtime_fixtures"),
+            "stock_gate": ledger.get("stock_runtime_gates"),
+            "contract_fingerprint": values.get("contract_fingerprint"),
+        })
+    except (OSError, json.JSONDecodeError, subprocess.SubprocessError) as exc:
+        errors.append(f"cannot validate QuakeC closure contract: {exc}")
+    return CheckResult("quakec_closure_contract", not errors, details, errors)
