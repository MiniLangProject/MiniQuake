+function Run-OriginalServerMiniClientPair([string]$Suffix, [int]$Port) {
+  $GameName = 'bp091_' + $Suffix
+  $GameDirectory = New-OriginalGameDirectory $GameName
+  $OriginalServerOut = Join-Path $Build ("bp090-094r14-original-server-{0}-stdout.log" -f $Suffix)
+  $OriginalServerErr = Join-Path $Build ("bp090-094r14-original-server-{0}-stderr.log" -f $Suffix)
+  $ProcessReportPath = Join-Path $Build ("bp090-094r14-original-server-{0}-process.json" -f $Suffix)
+  $ReadinessReportPath = Join-Path $Build ("bp090-094r14-original-server-{0}-readiness.json" -f $Suffix)
+  Remove-Item -Force -ErrorAction SilentlyContinue $ReadinessReportPath
+
+  # Never pass -condebug to the 1997 GLQUAKE.EXE on modern OpenGL drivers.
+  # console.c::Con_DebugLog owns a fixed 1024-byte buffer and uses vsprintf.
+  # Modern GL_EXTENSIONS strings are commonly much longer and corrupt memory
+  # before map startup. Readiness and connection evidence therefore come from
+  # process lifetime plus a real Protocol-3/Protocol-15 MiniQuake handshake.
+  $OriginalServerArgs = Join-NativeArguments @(
+    '-listen', '4', '-basedir', $OriginalBase, '-game', $GameName,
+    '-window', '-width', '640', '-height', '480', '-heapsize', '32768',
+    '-nosound', '-nocdaudio', '-nojoy', '-nomouse', '-noipx',
+    '-ip', '127.0.0.1', '-port', [string]$Port,
+    '+developer', '1', '+unbindall', '+map', 'start'
+  )
+  Write-Host ("[MiniQuake] starting original GLQuake loopback-only listen server {0} on 127.0.0.1:{1} without -condebug" -f $Suffix, $Port) -ForegroundColor Cyan
+  $OriginalServer = Start-BackgroundCapturedProcess -Executable $OriginalExe -ArgumentsText $OriginalServerArgs -Label ("original GLQuake listen server {0}" -f $Suffix)
+  $Readiness = $null
+
+  $Attempt = 0
+  $AttemptLogs = @()
+  $SignonComplete = $false
+  $SuccessfulSummaryPath = ""
+  $LastClientCode = -1
+  $LastClientText = ""
+  $ProcessAliveAfterSignon = $false
+
+  try {
+    # A cold 1997 GLQuake startup on a modern driver may spend tens of seconds
+    # creating its WGL context and uploading textures.  Do not launch the full
+    # MiniQuake interop client until a real CCREP_SERVER_INFO proves that the
+    # requested UDP socket and network event loop are ready.
+    $Readiness = Wait-OriginalServerControlReady -Handle $OriginalServer -Suffix $Suffix -Port $Port -TimeoutMilliseconds $OriginalServerReadyTimeoutMs -ReportPath $ReadinessReportPath
+    $Deadline = [DateTime]::UtcNow.AddMilliseconds(90000)
+
+    while ([DateTime]::UtcNow -lt $Deadline -and -not $SignonComplete) {
+      if ($OriginalServer.process.HasExited) {
+        $OriginalServer.process.WaitForExit()
+        $OriginalServer.process.Refresh()
+        throw ("original GLQuake listen server {0} exited before Protocol-15 signon: exit={1}" -f $Suffix, [int]$OriginalServer.process.ExitCode)
+      }
+
+      $Attempt = $Attempt + 1
+      $AttemptPrefix = Join-Path $Build ("bp090-094r14-miniquake-client-original-server-{0}-attempt-{1}" -f $Suffix, $Attempt)
+      $AttemptLogName = "bp090-094r14-miniquake-client-original-server-{0}-attempt-{1}.log" -f $Suffix, $Attempt
+      $AttemptLogPath = Join-Path $Build $AttemptLogName
+      $AttemptLogs += $AttemptLogName
+      Remove-Item -Force -ErrorAction SilentlyContinue ($AttemptPrefix + '-summary.json'), $AttemptLogPath
+
+      Write-Host ("[MiniQuake] starting MiniQuake client attempt {0} for original server {1}" -f $Attempt, $Suffix) -ForegroundColor Cyan
+      $ClientResult = Invoke-LiveProcess -Executable $GameExe -Arguments @(
+        '--original-interop-client', $QuakeBase, '127.0.0.1', [string]$Port,
+        [string]$OriginalInteropFrames, $AttemptPrefix, '-game', $Game
+      ) -LogPath $AttemptLogPath
+
+      $LastClientCode = [int]$ClientResult.exit_code
+      $LastClientText = [string]$ClientResult.text
+      $AttemptSummaryPath = $AttemptPrefix + '-summary.json'
+      if ($LastClientCode -eq 0 -and $LastClientText -match 'result=PASS' -and (Test-Path -LiteralPath $AttemptSummaryPath -PathType Leaf)) {
+        $AttemptSummary = Read-JsonFile $AttemptSummaryPath
+        $HasTargetUdpProvenance = (
+          $LastClientText -match 'network_provenance=target_udp' -and
+          $LastClientText -match 'transport=udp' -and
+          $LastClientText -match 'local_server_active=false' -and
+          $LastClientText -match 'local_authoritative=false' -and
+          $LastClientText -match 'demo_playback=false'
+        )
+        if ($AttemptSummary.success -and $AttemptSummary.connected -and $AttemptSummary.spawned -and [int]$AttemptSummary.signon -eq 4 -and [int]$AttemptSummary.protocol -eq 15 -and $HasTargetUdpProvenance) {
+          $SignonComplete = $true
+          $SuccessfulSummaryPath = $AttemptSummaryPath
+          break
+        }
+      }
+
+      if ([DateTime]::UtcNow -lt $Deadline) { Start-Sleep -Milliseconds 250 }
+    }
+
+    if (-not $SignonComplete) {
+      $LastLine = '<none>'
+      $ClientLines = @($LastClientText -split "`r?`n" | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
+      if ($ClientLines.Count -gt 0) { $LastLine = [string]$ClientLines[$ClientLines.Count - 1] }
+      throw ("MiniQuake client did not complete signon with original GLQuake server {0} after {1} attempts: exit={2} last={3}" -f $Suffix, $Attempt, $LastClientCode, $LastLine)
+    }
+
+    if ($OriginalServer.process.HasExited) {
+      $OriginalServer.process.WaitForExit()
+      $OriginalServer.process.Refresh()
+      throw ("original GLQuake listen server {0} exited immediately after signon: exit={1}" -f $Suffix, [int]$OriginalServer.process.ExitCode)
+    }
+    $ProcessAliveAfterSignon = $true
+
+    $Summary = Read-JsonFile $SuccessfulSummaryPath
+    $Normalized = Join-Path $Build ("bp090-094r14-original-server-mini-client-{0}-normalized.json" -f $Suffix)
+    [void](Write-NormalizedInteropSummary -InputPath $SuccessfulSummaryPath -Direction 'original_server_mini_client' -OutputPath $Normalized)
+    return $Normalized
+  } finally {
+    $AliveBeforeStop = $false
+    $ExitCodeBeforeStop = $null
+    try {
+      $AliveBeforeStop = -not $OriginalServer.process.HasExited
+      if (-not $AliveBeforeStop) {
+        $OriginalServer.process.WaitForExit()
+        $OriginalServer.process.Refresh()
+        $ExitCodeBeforeStop = [int]$OriginalServer.process.ExitCode
+      }
+    } catch { }
+    try {
+      [ordered]@{
+        schema_version = 1
+        suffix = $Suffix
+        port = $Port
+        process_mode = 'listen_with_video_context'
+        condebug_enabled = $false
+        network_scope = 'loopback_only'
+        bind_address = '127.0.0.1'
+        firewall_prompt_expected = $false
+        readiness_evidence = 'protocol3_server_info_then_target_udp_protocol15_signon4'
+        readiness_report = [IO.Path]::GetFileName($ReadinessReportPath)
+        readiness_status = if ($null -eq $Readiness) { 'not_completed' } else { [string]$Readiness.status }
+        readiness_probe_attempts = if ($null -eq $Readiness) { 0 } else { [int]$Readiness.probe_attempts }
+        readiness_elapsed_ms = if ($null -eq $Readiness) { 0 } else { [int]$Readiness.elapsed_ms }
+        readiness_map = if ($null -eq $Readiness) { '' } else { [string]$Readiness.map }
+        readiness_control_protocol = if ($null -eq $Readiness) { -1 } else { [int]$Readiness.control_protocol }
+        readiness_guard_local_port = if ($null -eq $Readiness) { 0 } else { [int]$Readiness.guard_local_port }
+        guard_socket_open_during_signon = if ($null -eq $Readiness) { $false } else { $null -ne $Readiness.guard_socket }
+        guard_close_order = 'after_original_process_stop'
+        pre_fallback_connect_required = $true
+        attempts = $Attempt
+        attempt_logs = $AttemptLogs
+        network_provenance_required = $true
+        persistent_control_socket = $true
+        connect_resend_ms = 500
+        connect_timeout_ms = 20000
+        local_fallback_rejected = $true
+        signon_complete = [bool]$SignonComplete
+        process_alive_after_signon = [bool]$ProcessAliveAfterSignon
+        process_alive_before_stop = [bool]$AliveBeforeStop
+        exit_code_before_stop = $ExitCodeBeforeStop
+      } | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath $ProcessReportPath -Encoding UTF8
+    } catch { }
+    Stop-OriginalServer -Handle $OriginalServer -StdoutPath $OriginalServerOut -StderrPath $OriginalServerErr
+    if ($null -ne $Readiness -and $null -ne $Readiness.guard_socket) {
+      try { $Readiness.guard_socket.Close() } catch { }
+      Write-Host ("[MiniQuake] original GLQuake readiness guard {0} closed after server stop" -f $Suffix) -ForegroundColor DarkGray
+    }
+  }
+}
+
+function Run-MiniServerOriginalClientPair([string]$Suffix, [int]$Port) {
+  $Prefix = Join-Path $Build ("bp090-094r14-miniquake-server-original-client-{0}" -f $Suffix)
+  $ReadyPath = $Prefix + '-ready.json'
+  $SummaryPath = $Prefix + '-summary.json'
+  $ServerOut = Join-Path $Build ("bp090-094r14-miniquake-server-original-client-{0}.log" -f $Suffix)
+  $ServerErr = Join-Path $Build ("bp090-094r14-miniquake-server-original-client-{0}.err.log" -f $Suffix)
+  $ProcessReportPath = Join-Path $Build ("bp090-094r14-original-client-{0}-process.json" -f $Suffix)
+  Remove-Item -Force -ErrorAction SilentlyContinue $ReadyPath, $SummaryPath, $ProcessReportPath
+  $ServerArgs = Join-NativeArguments @(
+    '--original-interop-server', $QuakeBase, 'start', [string]$Port,
+    [string]$OriginalInteropFrames, $Prefix, '-game', $Game
+  )
+  Write-Host ("[MiniQuake] starting MiniQuake original-client server {0} on UDP port {1}" -f $Suffix, $Port) -ForegroundColor Cyan
+  $Server = Start-BackgroundCapturedProcess -Executable $GameExe -ArgumentsText $ServerArgs -Label ("MiniQuake original-client server {0}" -f $Suffix)
+  $OriginalClient = $null
+  $GameName = 'bp092_' + $Suffix
+  $GameDirectory = New-OriginalGameDirectory $GameName
+  $ConfigName = 'interop.cfg'
+  $ConfigPath = Join-Path $GameDirectory $ConfigName
+  $ClientAliveAtSignon = $false
+  $ClientExitCode = $null
+  $ClientExitedBeforeSignon = $false
+  $ServerResult = $null
+  $FailureText = ''
+  try {
+    if (-not (Wait-ForFileText -Path $ReadyPath -Pattern '"ready"\s*:\s*true' -TimeoutMilliseconds 15000)) {
+      if ($Server.process.HasExited) { throw "MiniQuake interop server $Suffix exited before readiness" }
+      throw "MiniQuake interop server $Suffix did not report readiness within 15 seconds"
+    }
+
+    # Original Quake's Cmd_TokenizeString uses COM_Parse, where ':' is a
+    # standalone punctuation token. Host_Connect_f consumes only Cmd_Argv(1),
+    # so a host-colon-port console token silently drops PORT and targets 26000.
+    # Route the remote port through NET_Init's historical -port option and keep
+    # the console connect token free of a colon.
+    [IO.File]::WriteAllLines(
+      $ConfigPath,
+      @('unbindall', 'developer 1', 'name original_ref', 'color 0 0', 'connect 127.0.0.1'),
+      [Text.Encoding]::ASCII
+    )
+
+    # -condebug is intentionally omitted. The original Con_DebugLog uses an
+    # unsafe 1024-byte vsprintf buffer which modern GL extension strings exceed.
+    Write-Host ("[MiniQuake] starting original GLQuake client {0}: connect 127.0.0.1 via -port {1}" -f $Suffix, $Port) -ForegroundColor Cyan
+    $OriginalClient = Start-GuiProcess -Executable $OriginalExe -Arguments @(
+      '-basedir', $OriginalBase, '-game', $GameName,
+      '-window', '-width', '640', '-height', '480',
+      '-nosound', '-nocdaudio', '-nomouse', '-nojoy', '-noipx',
+      '-ip', '127.0.0.1', '-port', [string]$Port,
+      '+exec', $ConfigName
+    ) -WorkingDirectory (Join-Path $OriginalStage 'bin') -Label ("original GLQuake client {0}" -f $Suffix)
+
+    # Monitor both processes and the protocol summary. This preserves the
+    # foreground live output while giving a precise client status on failure.
+    $Deadline = [DateTime]::UtcNow.AddSeconds(60)
+    while ([DateTime]::UtcNow -lt $Deadline) {
+      if (Test-Path -LiteralPath $SummaryPath -PathType Leaf) { break }
+      if ($OriginalClient.HasExited) {
+        $OriginalClient.WaitForExit()
+        $OriginalClient.Refresh()
+        $ClientExitedBeforeSignon = $true
+        $ClientExitCode = [int]$OriginalClient.ExitCode
+        throw ("original GLQuake client {0} exited before completed signon: exit={1}" -f $Suffix, $ClientExitCode)
+      }
+      if ($Server.process.HasExited) { break }
+      Start-Sleep -Milliseconds 100
+    }
+
+    $Remaining = 5000
+    if (-not $Server.process.HasExited -and -not (Test-Path -LiteralPath $SummaryPath -PathType Leaf)) {
+      throw ("MiniQuake original-client server {0} timed out waiting for a Protocol-15 summary; original client alive={1}" -f $Suffix, (-not $OriginalClient.HasExited))
+    }
+    $ServerResult = Complete-BackgroundCapturedProcess -Handle $Server -TimeoutMilliseconds $Remaining -StdoutPath $ServerOut -StderrPath $ServerErr
+    if ([int]$ServerResult.exit_code -ne 0 -or [string]$ServerResult.stdout -notmatch 'result=PASS') {
+      throw "MiniQuake original-client server $Suffix failed: exit=$($ServerResult.exit_code)"
+    }
+    if ($OriginalClient.HasExited) {
+      $OriginalClient.WaitForExit()
+      $OriginalClient.Refresh()
+      $ClientExitCode = [int]$OriginalClient.ExitCode
+      throw ("original GLQuake client {0} exited before completed signon: exit={1}" -f $Suffix, $ClientExitCode)
+    }
+    $ClientAliveAtSignon = $true
+
+    $Summary = Read-JsonFile $SummaryPath
+    if (-not $Summary.success -or [int]$Summary.active_clients -lt 1 -or -not $Summary.spawned -or [int]$Summary.signon -lt 3 -or [int]$Summary.protocol -ne 15) {
+      throw "original client/MiniQuake server pair $Suffix did not prove complete signon"
+    }
+
+    [ordered]@{
+      schema_version = 1
+      suffix = $Suffix
+      port = $Port
+      condebug_enabled = $false
+      network_scope = 'loopback_only'
+      bind_address = '127.0.0.1'
+      firewall_prompt_expected = $false
+      evidence_source = 'miniquake_server_protocol15_summary'
+      original_command_parser = 'COM_Parse_colon_punctuation'
+      connect_token = '127.0.0.1'
+      remote_port_source = '-port'
+      remote_port = $Port
+      config_path = $ConfigPath
+      process_alive_at_completed_signon = [bool]$ClientAliveAtSignon
+      client_exited_before_signon = [bool]$ClientExitedBeforeSignon
+      client_exit_code = $ClientExitCode
+      active_clients = [int]$Summary.active_clients
+      spawned = [bool]$Summary.spawned
+      signon = [int]$Summary.signon
+      protocol = [int]$Summary.protocol
+      status = 'PASS'
+    } | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $ProcessReportPath -Encoding UTF8
+
+    $Normalized = Join-Path $Build ("bp090-094r14-mini-server-original-client-{0}-normalized.json" -f $Suffix)
+    [void](Write-NormalizedInteropSummary -InputPath $SummaryPath -Direction 'mini_server_original_client' -OutputPath $Normalized)
+    return $Normalized
+  } catch {
+    $FailureText = $_.Exception.Message
+    try {
+      if ($null -ne $OriginalClient) {
+        if ($OriginalClient.HasExited) {
+          $OriginalClient.WaitForExit()
+          $OriginalClient.Refresh()
+          $ClientExitCode = [int]$OriginalClient.ExitCode
+          $ClientExitedBeforeSignon = $true
+        }
+      }
+      [ordered]@{
+        schema_version = 1
+        suffix = $Suffix
+        port = $Port
+        condebug_enabled = $false
+        network_scope = 'loopback_only'
+        bind_address = '127.0.0.1'
+        firewall_prompt_expected = $false
+        evidence_source = 'miniquake_server_protocol15_summary'
+        original_command_parser = 'COM_Parse_colon_punctuation'
+        connect_token = '127.0.0.1'
+        remote_port_source = '-port'
+        remote_port = $Port
+        config_path = $ConfigPath
+        process_started = ($null -ne $OriginalClient)
+        process_alive_at_failure = ($null -ne $OriginalClient -and -not $OriginalClient.HasExited)
+        client_exited_before_signon = [bool]$ClientExitedBeforeSignon
+        client_exit_code = $ClientExitCode
+        summary_exists = (Test-Path -LiteralPath $SummaryPath -PathType Leaf)
+        server_exited = [bool]$Server.process.HasExited
+        failure = $FailureText
+        status = 'FAIL'
+      } | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $ProcessReportPath -Encoding UTF8
+    } catch { }
+    throw
+  } finally {
+    Stop-GuiProcess $OriginalClient
+    if ($null -ne $Server -and -not $Server.process.HasExited) { Stop-BackgroundCapturedProcess $Server }
+  }
+}
+
+function Get-OriginalTgaState([string]$Path) {
+  $Result = [ordered]@{ exists=$false; complete=$false; width=0; height=0; bits_per_pixel=0; image_type=0; color_map_type=0; id_length=0; actual_bytes=0; expected_bytes=0; sha256=''; last_write_utc=''; error='' }
+  if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return [pscustomobject]$Result }
+  try {
+    $Item=Get-Item -LiteralPath $Path -ErrorAction Stop; $Result.exists=$true; $Result.actual_bytes=[int64]$Item.Length; $Result.last_write_utc=$Item.LastWriteTimeUtc.ToString('o')
+    if ($Item.Length -lt 18) { return [pscustomobject]$Result }
+    $Bytes=[IO.File]::ReadAllBytes($Path); if ($Bytes.Length -lt 18) { return [pscustomobject]$Result }
+    $Id=[int]$Bytes[0]; $Cmap=[int]$Bytes[1]; $Type=[int]$Bytes[2]
+    $Width=[int]$Bytes[12]+256*[int]$Bytes[13]; $Height=[int]$Bytes[14]+256*[int]$Bytes[15]; $Bits=[int]$Bytes[16]
+    $Result.id_length=$Id; $Result.color_map_type=$Cmap; $Result.image_type=$Type; $Result.width=$Width; $Result.height=$Height; $Result.bits_per_pixel=$Bits
+    if ($Cmap -ne 0 -or $Type -ne 2 -or $Bits -ne 24 -or $Width -le 0 -or $Height -le 0) { $Result.error='unsupported or invalid TGA header'; return [pscustomobject]$Result }
+    $Expected=[int64](18+$Id)+[int64]$Width*[int64]$Height*3; $Result.expected_bytes=$Expected
+    if ([int64]$Bytes.Length -ne $Expected) { return [pscustomobject]$Result }
+    $Result.sha256=(Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant(); $Result.complete=$true
+  } catch { $Result.error=$_.Exception.Message }
+  return [pscustomobject]$Result
+}
+
+function Wait-OriginalTgaComplete([string]$GameDirectory,[System.Diagnostics.Process]$Process,[int]$TimeoutSeconds=90) {
+  $Deadline=[DateTime]::UtcNow.AddSeconds($TimeoutSeconds); $StablePolls=0; $LastHash=''; $LastState=$null; $Path=''; $ExitedBeforeComplete=$false; $ExitCodeBeforeComplete=$null
+  while ([DateTime]::UtcNow -lt $Deadline) {
+    if ([string]::IsNullOrWhiteSpace($Path)) {
+      $Found=Get-ChildItem -LiteralPath $GameDirectory -Filter 'quake*.tga' -File -ErrorAction SilentlyContinue | Sort-Object Name | Select-Object -First 1
+      if ($null -ne $Found) { $Path=$Found.FullName }
+    }
+    if (-not [string]::IsNullOrWhiteSpace($Path)) {
+      $State=Get-OriginalTgaState -Path $Path; $LastState=$State
+      if ($State.complete) {
+        if ($State.sha256 -eq $LastHash) { $StablePolls++ } else { $LastHash=$State.sha256; $StablePolls=1 }
+        if ($StablePolls -ge 3) {
+          $ExitedAfterCapture=$Process.HasExited; $ExitCodeAfterCapture=$null
