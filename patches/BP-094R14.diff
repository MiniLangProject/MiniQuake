+$TraceComparator = Join-Path $Root "tools\compare_traces.py"
+$RenderComparator = Join-Path $Root "tools\compare_render_evidence.py"
+$OriginalPrepareTool = Join-Path $Root "tools\prepare_original_reference.py"
+$OriginalVisualComparator = Join-Path $Root "tools\compare_original_reference.py"
+$Timestamp = Get-Date -Format "yyyyMMdd-HHmmss"
+$TranscriptPath = Join-Path $Build ("bp090-094r14-test-{0}.log" -f $Timestamp)
+$SummaryPath = Join-Path $Build "bp090-094r14-test-summary.json"
+$Steps = New-Object System.Collections.Generic.List[object]
+$FirewallReportPath = Join-Path $Build "bp090-094r14-temporary-firewall-rules.json"
+$FirewallRulePrefix = "MiniQuake-BP090094R14-Temporary"
+$FirewallDisplayGroup = "MiniQuake BP-090-094R14 temporary loopback interop"
+$FirewallRuleNames = @()
+$FirewallRulesInstalled = $false
+$FirewallCleanupStatus = "not_installed"
+$FirewallSetupStatus = "not_requested"
+$FirewallSetupError = ""
+$OriginalReferenceSourceKind = ""
+$OriginalReferenceSourcePath = ""
+$OriginalReferenceResolution = ""
+$OriginalInputReportPath = Join-Path $Build "bp090-094r14-original-reference-input.json"
+$ScriptInvocationParameters = @{}
+foreach ($Entry in $PSBoundParameters.GetEnumerator()) {
+  $InvocationKey = [string]$Entry.Key
+  $ScriptInvocationParameters[$InvocationKey] = $Entry.Value
+}
