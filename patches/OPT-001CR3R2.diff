+    (Join-Path $Root "tools\analyze_opt001a.py"), "--build", $Build,
+    "--prefix", "opt001cr3r2", "--next-revision", "OPT-001D",
+    "--json", (Join-Path $Build "opt001cr3r2-baseline-summary.json"),
+    "--markdown", (Join-Path $Build "opt001cr3r2-baseline-summary.md")
+  ) "opt001cr3r2-aggregate-analysis.log" -AllowFailure)
+
+  $PerformanceJson = Join-Path $Build "opt001cr3r2-performance-comparison.json"
+  [void](Invoke-Live "OPT-001CR3R2 performance comparison" $PythonExe @(
+    (Join-Path $Root "tools\compare_opt001c_performance.py"),
+    "--baseline", (Join-Path $Root "audit\opt001b_performance_baseline.json"),
+    "--build", $Build,
+    "--prefix", "opt001cr3r2",
+    "--json", $PerformanceJson,
+    "--markdown", (Join-Path $Build "opt001cr3r2-performance-comparison.md")
+  ) "opt001cr3r2-performance-comparison.log")
+
+  [void](Invoke-Live "OPT-001CR3R2 incremental performance comparison" $PythonExe @(
+    (Join-Path $Root "tools\compare_opt001cr3_performance.py"),
+    "--baseline", (Join-Path $Root "audit\opt001cr2_accepted_baseline.json"),
+    "--build", $Build,
+    "--prefix", "opt001cr3r2",
+    "--json", (Join-Path $Build "opt001cr3r2-incremental-performance.json"),
+    "--markdown", (Join-Path $Build "opt001cr3r2-incremental-performance.md")
+  ) "opt001cr3r2-incremental-performance.log")
+
