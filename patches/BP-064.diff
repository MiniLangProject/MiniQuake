+  [ValidateSet("Release", "Debug")]
+  [string]$Configuration = "Release",
+  [switch]$SkipBuild,
+  [switch]$SkipGameValidation,
+  [switch]$SkipTraceValidation,
+  [switch]$SkipRenderEvidence,
+  [switch]$SkipAudioEvidence,
+  [switch]$SkipNetworkEvidence,
+  [switch]$NetworkTests,
+  [switch]$RebuildNative,
+  [switch]$Listings,
+  [switch]$ContinueIndependentTests = $true,
+  [switch]$BisectOnFailure
+)
+
+$ErrorActionPreference = "Stop"
+Set-StrictMode -Version Latest
+
+$PackageId = "BP-064"
+$ParentPackageId = "BP-063"
+$BlockId = "BP-060-064"
+$DeliveryRevision = "BP-060-064"
+$BlockParentPackageId = "BP-055-059R2"
+$Root = $PSScriptRoot
+$Build = Join-Path $Root "build"
+$BuildScript = Join-Path $Root "build.ps1"
+$GameExe = Join-Path $Build "MiniQuake.exe"
+$EvidenceExe = Join-Path $Build "MiniQuakeNetworkPlatformEvidence.exe"
+$TraceComparator = Join-Path $Root "tools\compare_traces.py"
+$RenderComparator = Join-Path $Root "tools\compare_render_evidence.py"
+$Timestamp = Get-Date -Format "yyyyMMdd-HHmmss"
+$TranscriptPath = Join-Path $Build ("bp060-064-test-{0}.log" -f $Timestamp)
+$SummaryPath = Join-Path $Build "bp060-064-test-summary.json"
+$Steps = New-Object System.Collections.Generic.List[object]
+
+function Resolve-Tool([string]$Value, [string]$Label) {
+  if (-not [string]::IsNullOrWhiteSpace($Value) -and (Test-Path -LiteralPath $Value -PathType Leaf)) {
+    return [IO.Path]::GetFullPath($Value)
+  }
+  if (-not [string]::IsNullOrWhiteSpace($Value)) {
+    $Command = Get-Command $Value -ErrorAction SilentlyContinue | Select-Object -First 1
+    if ($null -ne $Command) { return $Command.Path }
+  }
+  throw "$Label not found: $Value"
+}
+
+function Add-Step([string]$Name, [string]$Status, [int]$ExitCode, [string]$Detail) {
+  $Steps.Add([ordered]@{ name = $Name; status = $Status; exit_code = $ExitCode; detail = $Detail })
+  $Color = if ($Status -eq "PASS") { "Green" } elseif ($Status -eq "SKIPPED") { "Yellow" } else { "Red" }
+  Write-Host ("[{0}] {1} - {2}" -f $Status, $Name, $Detail) -ForegroundColor $Color
+}
+
+function Failure-Marker([string]$Text) {
+  if ([string]::IsNullOrWhiteSpace($Text)) { return "" }
+  foreach ($Line in ($Text -split "`r?`n")) {
+    if ($Line -match '^\s*FAIL:\s*' -or $Line -match 'tests failed:\s*[1-9]' -or $Line -match 'evidence:\s*FAIL') { return $Line.Trim() }
+  }
+  return ""
+}
+
+function Run-Logged([string]$Name, [string]$Executable, [string[]]$Arguments, [string]$LogName, [string]$RequiredMarker = "") {
+  $LogPath = Join-Path $Build $LogName
+  $Lines = @(& $Executable @Arguments 2>&1)
+  $Code = [int]$LASTEXITCODE
+  $Lines | Set-Content -LiteralPath $LogPath -Encoding UTF8
+  $Lines | ForEach-Object { Write-Host $_ }
+  $Text = ($Lines | ForEach-Object { [string]$_ }) -join "`n"
+  $Marker = Failure-Marker $Text
+  if ($Code -eq 0 -and -not [string]::IsNullOrWhiteSpace($Marker)) { $Code = 1 }
+  if ($Code -eq 0 -and -not [string]::IsNullOrWhiteSpace($RequiredMarker) -and $Text -notmatch [regex]::Escape($RequiredMarker)) { $Code = 1; $Marker = "missing marker: $RequiredMarker" }
+  if ($Code -ne 0) { Add-Step $Name "FAIL" $Code ("log=" + $LogName + " " + $Marker); throw "$Name failed with exit code $Code" }
+  Add-Step $Name "PASS" 0 ("log=" + $LogName)
+  return $Text
+}
+
+function Run-NetworkEvidencePair([string]$Suffix, [int]$Port) {
+  $ServerOut = Join-Path $Build ("bp060-064-network-server-{0}.log" -f $Suffix)
+  $ServerErr = Join-Path $Build ("bp060-064-network-server-{0}.err.log" -f $Suffix)
+  $ClientLog = Join-Path $Build ("bp060-064-network-client-{0}.log" -f $Suffix)
+  Remove-Item -Force -ErrorAction SilentlyContinue $ServerOut, $ServerErr, $ClientLog
+  $Server = Start-Process -FilePath $EvidenceExe -ArgumentList @("server", [string]$Port) -PassThru -NoNewWindow -RedirectStandardOutput $ServerOut -RedirectStandardError $ServerErr
+  Start-Sleep -Milliseconds 300
+  $ClientLines = @(& $EvidenceExe "client" ([string]$Port) 2>&1)
+  $ClientCode = [int]$LASTEXITCODE
+  $ClientLines | Set-Content -LiteralPath $ClientLog -Encoding UTF8
+  if (-not $Server.WaitForExit(7000)) { Stop-Process -Id $Server.Id -Force -ErrorAction SilentlyContinue; throw "network evidence server $Suffix timed out" }
+  $ServerCode = $Server.ExitCode
+  $ServerText = ""
+  if (Test-Path $ServerOut) { $ServerText = Get-Content -Raw -LiteralPath $ServerOut }
+  if (Test-Path $ServerErr) { $ServerText += Get-Content -Raw -LiteralPath $ServerErr }
+  $ClientText = ($ClientLines | ForEach-Object { [string]$_ }) -join "`n"
+  if ($ServerCode -ne 0 -or $ClientCode -ne 0) { throw "network evidence pair $Suffix failed: server=$ServerCode client=$ClientCode" }
+  if ($ServerText -notmatch 'network platform evidence server: PASS') { throw "network evidence server $Suffix did not report PASS" }
+  if ($ClientText -notmatch 'network platform evidence: PASS') { throw "network evidence client $Suffix did not report PASS" }
+  return $ClientLog
+}
