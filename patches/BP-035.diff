-function resourceHighWater(high, value)
-  updated = []
-  index = 0
-  while index < len(value)
-    maximum = high[index]
-    if value[index] > maximum then maximum = value[index] end if
-    updated = updated + [maximum]
-    index = index + 1
-  end while
-  return updated
-end function
