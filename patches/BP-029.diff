+
+    $TraceA = $PrefixA + ".mqtrace"
+    $TraceB = $PrefixB + ".mqtrace"
+    $SnapshotA = $PrefixA + "-snapshot.json"
+    $ContextA = $PrefixA + "-context.json"
+    $SummaryAPath = $PrefixA + "-summary.json"
+    $SummaryBPath = $PrefixB + "-summary.json"
