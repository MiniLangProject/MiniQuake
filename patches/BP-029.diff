+  frozen = movement.create(t.Vec3(0.0, 0.0, 24.0), t.Vec3(0.0, 0.0, 0.0))
+  frozen.punchAngle = t.Vec3(5.0, 0.0, 0.0)
+  svuser.SV_UserSetFrozen(state, true)
