+} elseif (-not [System.IO.Path]::IsPathRooted($Output)) {
+  $Output = Join-Path $Root $Output
+}
+$Output = [System.IO.Path]::GetFullPath($Output)
+
+$Staging = Join-Path $BuildDirectory (".bp025-029-results-{0}" -f $Timestamp)
+$AllowedExtensions = @(".log", ".json", ".txt", ".csv", ".mqtrace")
+if ($IncludeScreenshots) { $AllowedExtensions += ".png" }
+$ForbiddenExtensions = @(".pak", ".bsp", ".mdl", ".spr", ".wad", ".dem", ".sav", ".lmp", ".ogg", ".wav", ".dat")
+$MaximumFileBytes = 25MB
+
+function Add-SafeFile {
+  param(
+    [Parameter(Mandatory = $true)]
+    [string]$Source,
+
+    [Parameter(Mandatory = $true)]
+    [string]$RelativeDestination
+  )
+
+  if (-not (Test-Path -LiteralPath $Source -PathType Leaf)) { return }
+  $Item = Get-Item -LiteralPath $Source
+  if ($Item.Length -gt $MaximumFileBytes) {
+    Write-Warning "Skipping oversized result file: $Source"
+    return
+  }
+  if ($ForbiddenExtensions -contains $Item.Extension.ToLowerInvariant()) {
+    Write-Warning "Skipping game-data-like file: $Source"
+    return
+  }
+  $Destination = Join-Path $Staging $RelativeDestination
+  New-Item -ItemType Directory -Force -Path (Split-Path -Parent $Destination) | Out-Null
+  Copy-Item -Force -LiteralPath $Source -Destination $Destination
+}
