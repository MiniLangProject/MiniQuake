+            errors.append("BLOCK_LEDGER.json runtime fixture total differs from 125")
+        for package in ("BP-025", "BP-026", "BP-027", "BP-028", "BP-029"):
+            patch = root / "patches" / f"{package}.diff"
+            if not patch.is_file() or patch.stat().st_size == 0:
