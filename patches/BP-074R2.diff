+}
+
+if (-not [string]::IsNullOrWhiteSpace($Failure)) {
+  Write-Host "MiniQuake BP-070-074R2 acceptance test: FAIL" -ForegroundColor Red
+  Write-Host "Run .\COLLECT_RESULTS.ps1 and upload the generated ZIP."
